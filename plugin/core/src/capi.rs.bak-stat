//! 给 C++ librime 模块壳使用的 C ABI。
//!
//! 设计原则：Rust 侧持有全部统计状态与协议逻辑（含 Lua translator 的前置步骤、生字/词判定、
//! 落盘计数），C++ 侧只负责"取时间 → 调用 → 拿字符串/写文件"，不解释任何统计字段。
//! 所有指针都由本模块分配/释放，跨语言边界只传不透明句柄与 `char*`。
//!
//! 对应头文件：`plugin/include/rime_input_stats.h`（两边必须保持一致）。

use std::ffi::{c_char, c_int, CString};
use std::sync::Mutex;

use crate::persist;
use crate::state::{
    adjusted_code_len, avg_available, count_key_press, observe_new_word, session_available,
    should_interrupt, update_stats, utf8_char_count, AvgSpdInfo, Commit, InputStats,
    DEFAULT_BOGGLE_THRESHOLD_SECONDS, LOG_VERSION,
};
use crate::time::bucket_bounds;

/// 落盘阈值：`cnts_of_commit > SAVE_INTERVAL` 时才写文件（Lua §4.3，第 21 次）。
pub const SAVE_INTERVAL: i64 = 20;

/// 不透明句柄：Rust 侧的统计会话。
pub struct StatsHandle {
    stats: InputStats,
    avg: AvgSpdInfo,
    /// 自上次上屏以来累计的按键数（结算后清零）。
    key_touch_cnt: i64,
    /// 上一次的编码串（Lua `lastCode`）。
    last_code: String,
    /// 上屏计数，用于触发落盘（Lua `cntsOfCommit`）。
    cnts_of_commit: i64,
    /// 卡壳门限（秒），对应 Lua 顶部可配置项。
    boggle_threshold_s: i64,
    /// 自动顶屏码长集合（Lua `codeLenOfAutoCommit`，默认 `{0}`）。
    auto_commit: Vec<i64>,
    /// 报表上下文：方案名。
    schema_name: String,
    /// 报表上下文：发行版名与版本。
    software_name: String,
    software_version: String,
    /// 报表风格是否为长款（Lua `reportStyle != 0`）。
    style_long: bool,
    /// 平均码长说明（长款追加到槽 6）。
    avg_code_len_desc: String,
    /// 名言缓存（Lua `quotes`，由宿主读取 quote.txt 后注入）。
    quotes: Vec<String>,
    /// 名言随机数状态（Lua 用 `math.randomseed(os.time())`）。
    rng: u64,
}

impl StatsHandle {
    fn new() -> Self {
        Self {
            stats: InputStats::default(),
            avg: AvgSpdInfo::default(),
            key_touch_cnt: 0,
            last_code: String::new(),
            cnts_of_commit: 0,
            boggle_threshold_s: DEFAULT_BOGGLE_THRESHOLD_SECONDS,
            auto_commit: vec![0],
            schema_name: String::new(),
            software_name: String::new(),
            software_version: String::new(),
            style_long: false,
            avg_code_len_desc: String::new(),
            quotes: Vec::new(),
            rng: 0,
        }
    }

    /// xorshift64*：均匀取一条名言（无外部依赖，可由 `now_unix` 复现）。
    fn next_random(&mut self) -> u64 {
        if self.rng == 0 {
            self.rng = 0x9E37_79B9_7F4A_7C15;
        }
        let mut x = self.rng;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.rng = x;
        x.wrapping_mul(0x2545_F491_4F6C_DD1D)
    }

    /// 按 Lua 语义随机挑一条名言（`math.floor(math.random() * quoteCnt) + 1`）。
    fn pick_quote(&mut self) -> Option<String> {
        if self.quotes.is_empty() {
            return None;
        }
        let index = (self.next_random() % self.quotes.len() as u64) as usize;
        self.quotes.get(index).cloned()
    }
}

/// 把 `(ptr, len)` 读成 `&str`；空指针或非法 UTF-8 返回 `None`。
///
/// # Safety
/// `ptr` 必须指向至少 `len` 个可读字节。
unsafe fn as_str<'a>(ptr: *const c_char, len: usize) -> Option<&'a str> {
    if ptr.is_null() {
        return None;
    }
    let bytes = unsafe { std::slice::from_raw_parts(ptr as *const u8, len) };
    std::str::from_utf8(bytes).ok()
}

/// 创建统计句柄；失败返回空指针。
#[no_mangle]
pub extern "C" fn rime_input_stats_new() -> *mut StatsHandle {
    Box::into_raw(Box::new(StatsHandle::new()))
}

/// 释放统计句柄；空指针安全。
///
/// # Safety
/// `handle` 必须来自 [`rime_input_stats_new`]，且不得重复释放。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_free(handle: *mut StatsHandle) {
    if !handle.is_null() {
        drop(unsafe { Box::from_raw(handle) });
    }
}

/// 设置自动顶屏码长集合（默认 `{0}`，等价于"总是 +1"）。
///
/// # Safety
/// `handle` 必须是有效句柄；`codes` 指向至少 `len` 个 `i64`。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_set_auto_commit(
    handle: *mut StatsHandle,
    codes: *const i64,
    len: usize,
) {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return;
    };
    if codes.is_null() || len == 0 {
        state.auto_commit = vec![0];
        return;
    }
    state.auto_commit = unsafe { std::slice::from_raw_parts(codes, len) }.to_vec();
}

/// 设置卡壳门限（秒），负值按默认 3 处理。
///
/// # Safety
/// `handle` 必须是有效句柄。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_set_boggle_threshold(
    handle: *mut StatsHandle,
    seconds: i64,
) {
    if let Some(state) = unsafe { handle.as_mut() } {
        state.boggle_threshold_s = if seconds < 0 {
            DEFAULT_BOGGLE_THRESHOLD_SECONDS
        } else {
            seconds
        };
    }
}

/// 翻译器前置步骤（Lua `translator` 第 1–3 步）：
///
/// 1. 与上次按键间隔严格大于 `gapThd` 视为中断：必要时结算上一段会话，并重置
///    `startTime`/`commitTime`；
/// 2. 依据 `lastCode` 与当前编码判定本次是否计一次击键；
/// 3. 维护 `lastCode`。
///
/// 返回 `1` 表示当前输入以 `/` 开头（命令输入，宿主应继续做命令分发），否则返回 `0`。
///
/// # Safety
/// `handle` 必须是有效句柄；`input` 指向至少 `input_len` 个可读字节。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_on_query(
    handle: *mut StatsHandle,
    input: *const c_char,
    input_len: usize,
    now_unix: i64,
    tz_offset_seconds: i32,
) -> c_int {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return 0;
    };
    let Some(input) = (unsafe { as_str(input, input_len) }) else {
        return 0;
    };

    // 第 1 步：输入中断。
    if should_interrupt(&state.avg, now_unix) {
        if session_available(&state.avg) {
            let bounds = bucket_bounds(now_unix, tz_offset_seconds);
            update_stats(
                &mut state.stats,
                &mut state.avg,
                &mut state.key_touch_cnt,
                bounds,
                Commit {
                    input_length: 0,
                    code_len: 0,
                    code_len_without_space: 0,
                    avg_available: true,
                },
            );
        }
        state.avg.start_time = now_unix;
        state.avg.commit_time = now_unix;
    }
    state.avg.click_time = now_unix;

    // 第 2 步：击键计数。
    state.key_touch_cnt += count_key_press(&state.last_code, input);

    // 第 3 步：lastCode 维护。
    if input.starts_with('/') {
        state.last_code.clear();
        1
    } else {
        state.last_code = input.to_owned();
        0
    }
}

/// 当前是否值得参与平均分速结算（Lua `avgAvailable`）。
///
/// # Safety
/// `handle` 必须是有效句柄。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_avg_available(handle: *const StatsHandle) -> c_int {
    match unsafe { handle.as_ref() } {
        Some(state) => c_int::from(avg_available(&state.avg)),
        None => 0,
    }
}

/// 判定一次上屏是否计入统计（Lua commit 回调开头的四道守卫）。
///
/// `input` 是提交时的编码串，`commit_text` 是上屏文本。返回值：
/// * `0` = 正常统计；
/// * `1` = **不统计并清零击键计数**（空上屏 / 编码与上屏一致 / 命令输入 / 上屏含非汉字）；
/// * `2` = 不统计但**保留**击键计数（纯标点或数字）。
///
/// 宿主必须调用本函数，否则统计报表自身（`/rtj` 产出的长文本）也会被当成一次上屏计入，
/// 字数、均速与平均码长都会失真。
///
/// # Safety
/// 各 `*_ptr/len` 组合要么为空指针、要么指向可读的 UTF-8 字节。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_classify_commit(
    input: *const c_char,
    input_len: usize,
    commit_text: *const c_char,
    text_len: usize,
) -> c_int {
    let input = unsafe { as_str(input, input_len) }.unwrap_or("");
    let text = unsafe { as_str(commit_text, text_len) }.unwrap_or("");
    match crate::commit_gate::classify_commit(input, text) {
        crate::commit_gate::CommitDisposition::Count => 0,
        crate::commit_gate::CommitDisposition::SkipAndResetKeys => 1,
        crate::commit_gate::CommitDisposition::SkipKeepKeys => 2,
    }
}

/// 清零击键计数（Lua 的 `keyTouchCnt = 0`，在放弃统计本次上屏时调用）。
///
/// # Safety
/// `handle` 必须是有效句柄。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_reset_key_touch(handle: *mut StatsHandle) {
    if let Some(state) = unsafe { handle.as_mut() } {
        state.key_touch_cnt = 0;
    }
}

/// 记录一次上屏（Lua commit 回调）：码长修正 → 累计 → 生字/词判定 → 落盘计数。
///
/// `commit_text` 是上屏文本（UTF-8），`raw_code_len` 是 `string.len(ctx.input)`
/// （**不含**顶屏空格）。返回 `1` 表示宿主应当立即落盘（Lua §4.3：第 21/42/63… 次）。
///
/// # Safety
/// `handle` 必须是有效句柄；`commit_text` 指向至少 `text_len` 个可读字节。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_on_commit(
    handle: *mut StatsHandle,
    commit_text: *const c_char,
    text_len: usize,
    raw_code_len: i64,
    now_unix: i64,
    tz_offset_seconds: i32,
) -> c_int {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return 0;
    };
    let text = unsafe { as_str(commit_text, text_len) }.unwrap_or("");
    if text.is_empty() {
        return 0;
    }

    let code_len = adjusted_code_len(raw_code_len, &state.auto_commit);
    state.avg.count += utf8_char_count(text);
    state.avg.code_len += code_len;
    state.avg.commit_time = now_unix;

    let last_commit_time = state.avg.commit_time;
    observe_new_word(
        &mut state.stats,
        text,
        now_unix,
        state.boggle_threshold_s,
        last_commit_time,
    );

    let bounds = bucket_bounds(now_unix, tz_offset_seconds);
    update_stats(
        &mut state.stats,
        &mut state.avg,
        &mut state.key_touch_cnt,
        bounds,
        Commit {
            input_length: utf8_char_count(text),
            code_len,
            code_len_without_space: raw_code_len,
            avg_available: false,
        },
    );

    state.last_code.clear();
    state.cnts_of_commit += 1;
    if state.cnts_of_commit > SAVE_INTERVAL {
        state.cnts_of_commit = 0;
        1
    } else {
        0
    }
}

/// 用统计文件内容初始化/替换状态（含 §4.4 版本迁移）。
///
/// 返回 `1` 表示成功（可能发生了迁移），`0` 表示解析失败（状态保持不变）。
///
/// # Safety
/// `handle` 必须是有效句柄；`text` 指向至少 `text_len` 个可读字节。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_load(
    handle: *mut StatsHandle,
    text: *const c_char,
    text_len: usize,
) -> c_int {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return 0;
    };
    let Some(text) = (unsafe { as_str(text, text_len) }) else {
        return 0;
    };
    let Ok(mut parsed) = persist::parse(text) else {
        return 0;
    };
    parsed.migrate_format(LOG_VERSION);
    state.stats = parsed;
    1
}

/// 序列化当前统计（Lua 版同语法）；调用方用 [`rime_input_stats_string_free`] 释放。
///
/// # Safety
/// `handle` 必须是有效句柄。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_serialize(handle: *const StatsHandle) -> *mut c_char {
    let Some(state) = (unsafe { handle.as_ref() }) else {
        return std::ptr::null_mut();
    };
    match CString::new(persist::serialize(&state.stats)) {
        Ok(text) => text.into_raw(),
        Err(_) => std::ptr::null_mut(),
    }
}

/// 释放 [`rime_input_stats_serialize`] 返回的字符串。
///
/// # Safety
/// `text` 必须来自 [`rime_input_stats_serialize`]，且不得重复释放。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_string_free(text: *mut c_char) {
    if !text.is_null() {
        drop(unsafe { CString::from_raw(text) });
    }
}

/// 设置报表上下文（方案名、发行版名/版本、设备类型、平均码长说明）。
///
/// 设备类型只接受 `📱` / `💻` / 空串；其余取值按识别失败处理（报表命令会拒绝执行）。
/// 报表风格不在这里设置：它由 [`rime_input_stats_note_report_style`] 按命令串推导。
///
/// # Safety
/// `handle` 必须是有效句柄；各 `*_ptr/len` 组合指向可读的 UTF-8 字节。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_set_report_context(
    handle: *mut StatsHandle,
    schema_name: *const c_char,
    schema_len: usize,
    software_name: *const c_char,
    software_len: usize,
    software_version: *const c_char,
    version_len: usize,
    device_type: *const c_char,
    device_len: usize,
    avg_code_len_desc: *const c_char,
    desc_len: usize,
) {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return;
    };
    let text = |ptr: *const c_char, len: usize| -> String {
        unsafe { as_str(ptr, len) }.unwrap_or("").to_owned()
    };
    state.schema_name = text(schema_name, schema_len);
    state.software_name = text(software_name, software_len);
    state.software_version = text(software_version, version_len);
    state.avg_code_len_desc = text(avg_code_len_desc, desc_len);

    let device = text(device_type, device_len);
    let device = match device.as_str() {
        "📱" => "📱",
        "💻" => "💻",
        _ => "",
    };
    state.stats.device_type = device.to_owned();
}

/// 追加一条名言（宿主读取 quote.txt 后逐行注入，空行由宿主跳过）。
///
/// # Safety
/// `handle` 必须是有效句柄；`text` 指向至少 `len` 个可读字节。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_add_quote(
    handle: *mut StatsHandle,
    text: *const c_char,
    len: usize,
) {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return;
    };
    if let Some(quote) = unsafe { as_str(text, len) } {
        if !quote.is_empty() {
            state.quotes.push(quote.to_owned());
        }
    }
}

/// 按 Lua 语义记录报表风格（规范 §5.0）：输入长度 > 1 时，**末两位相同 → 长款**，否则短款。
///
/// 宿主应在每次命令输入时调用（该状态跨命令保持，且不落盘）。
///
/// # Safety
/// `handle` 必须是有效句柄；`input` 指向至少 `input_len` 个可读字节。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_note_report_style(
    handle: *mut StatsHandle,
    input: *const c_char,
    input_len: usize,
) {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return;
    };
    let Some(input) = (unsafe { as_str(input, input_len) }) else {
        return;
    };
    if input.len() <= 1 {
        return;
    }
    let bytes = input.as_bytes();
    let (last, second_last) = (bytes[bytes.len() - 1], bytes[bytes.len() - 2]);
    state.style_long = last == second_last;
}

/// 已加载的名言条数。
///
/// # Safety
/// `handle` 必须是有效句柄。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_quote_count(handle: *const StatsHandle) -> i64 {
    match unsafe { handle.as_ref() } {
        Some(state) => state.quotes.len() as i64,
        None => 0,
    }
}

/// 执行一条以 `/` 开头的命令（规范 §5、§6）。
///
/// 返回回显文本（可能为空串或空指针），并通过 `out_save` 告诉宿主是否需要立即落盘：
/// `1` = 立即写文件。未识别的输入返回空指针，宿主应把它当普通输入处理。
///
/// `now_unix` / `tz_offset_seconds` 用于报表时间戳与名言随机数的种子。
///
/// # Safety
/// `handle` 必须是有效句柄；`input` 指向至少 `input_len` 个可读字节；`out_save` 可为空指针。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_run_command(
    handle: *mut StatsHandle,
    input: *const c_char,
    input_len: usize,
    now_unix: i64,
    tz_offset_seconds: i32,
    out_save: *mut c_int,
) -> *mut c_char {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return std::ptr::null_mut();
    };
    let Some(input) = (unsafe { as_str(input, input_len) }) else {
        return std::ptr::null_mut();
    };
    let Some(command) = crate::command::recognize(input) else {
        return std::ptr::null_mut();
    };
    // 名言随机（Lua 在 init 里 math.randomseed(os.time())，这里以当次时间为种子）。
    if state.rng == 0 {
        state.rng = (now_unix as u64) | 1;
    }
    let quote = state.pick_quote();
    let context = crate::command::CommandContext {
        now_unix,
        tz_offset_seconds,
        schema_name: &state.schema_name,
        software_name: &state.software_name,
        software_version: &state.software_version,
        device_type: crate::report::DeviceType::parse(&state.stats.device_type),
        style: if state.style_long {
            crate::report::Style::Long
        } else {
            crate::report::Style::Short
        },
        avg_code_len_desc: &state.avg_code_len_desc,
        quote: quote.as_deref(),
    };
    let outcome = crate::command::run_command(&mut state.stats, command, &context);
    if !out_save.is_null() {
        unsafe { *out_save = c_int::from(outcome.save) };
    }
    match CString::new(outcome.text) {
        Ok(text) => text.into_raw(),
        Err(_) => std::ptr::null_mut(),
    }
}

/// 结算当前会话（Lua `update_stats(0, 0, 0, avgAvailable)`）。
///
/// `settle` 为 0 时只做跨周期刷新，不推进 `avgGaps/avgCnts/avgCodeLen`（§5.9 报表命令的两种分支）。
///
/// # Safety
/// `handle` 必须是有效句柄。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_settle_session(
    handle: *mut StatsHandle,
    now_unix: i64,
    tz_offset_seconds: i32,
    settle: c_int,
) {
    let Some(state) = (unsafe { handle.as_mut() }) else {
        return;
    };
    let bounds = bucket_bounds(now_unix, tz_offset_seconds);
    update_stats(
        &mut state.stats,
        &mut state.avg,
        &mut state.key_touch_cnt,
        bounds,
        Commit {
            input_length: 0,
            code_len: 0,
            code_len_without_space: 0,
            avg_available: settle != 0,
        },
    );
}

/// 按当前 `LOG_VERSION` 做版本迁移（§4.4）；返回 1 表示发生了破坏性重置。
///
/// 统计文件不存在时不会调用 [`rime_input_stats_load`]，此时宿主必须调用本函数，
/// 否则内存里的 `logVer` 会一直停留在 `-1` 并被写回文件。
///
/// # Safety
/// `handle` 必须是有效句柄。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_ensure_current(handle: *mut StatsHandle) -> c_int {
    match unsafe { handle.as_mut() } {
        Some(state) => c_int::from(state.stats.migrate_format(LOG_VERSION)),
        None => 0,
    }
}

/// 判定输入是否为"报表类命令"（报表命令与生字词本命令需要先结算会话，§5.9）。
///
/// # Safety
/// `input` 指向至少 `input_len` 个可读字节。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_is_report_command(
    input: *const c_char,
    input_len: usize,
) -> c_int {
    let Some(input) = (unsafe { as_str(input, input_len) }) else {
        return 0;
    };
    match crate::command::recognize(input) {
        Some(crate::command::Command::Report(_) | crate::command::Command::NewWordsReport) => 1,
        _ => 0,
    }
}

/// 读取汇总字段，供宿主做快速判断与测试。
///
/// `field`：`0` 当日上屏次数、`1` 当日字数、`2` 当日最长上屏、`3` 当日按键数、
/// `4` 生字/词数量、`5` 皮肤索引（字词）、`6` 皮肤索引（码长）、`7` 落盘格式版本。
/// 未知字段返回 `-1`。
///
/// # Safety
/// `handle` 必须是有效句柄。
#[no_mangle]
pub unsafe extern "C" fn rime_input_stats_field(handle: *const StatsHandle, field: c_int) -> i64 {
    let Some(state) = (unsafe { handle.as_ref() }) else {
        return -1;
    };
    match field {
        0 => state.stats.daily.count,
        1 => state.stats.daily.length,
        2 => state.stats.daily_max,
        3 => state.stats.daily.key_touch_cnt,
        4 => state.stats.new_words.words.len() as i64,
        5 => state.stats.skin_idx_word,
        6 => state.stats.skin_idx_code,
        7 => state.stats.log_ver,
        _ => -1,
    }
}

/// 返回核心版本字符串（静态，不需释放）。
#[no_mangle]
pub extern "C" fn rime_input_stats_version() -> *const c_char {
    static VERSION: &str = concat!("rime-input-stats-core ", env!("CARGO_PKG_VERSION"), "\0");
    VERSION.as_ptr().cast()
}

/// 句柄是 `Send` 的（内部只有纯数据），供 C++ 侧在工作线程持有。
const _: fn() = || {
    fn assert_send<T: Send>() {}
    assert_send::<Mutex<StatsHandle>>();
};

#[cfg(test)]
mod tests {
    use super::*;
    use std::ffi::CStr;

    unsafe fn query(handle: *mut StatsHandle, input: &str, now: i64) -> c_int {
        unsafe {
            rime_input_stats_on_query(
                handle,
                input.as_ptr() as *const c_char,
                input.len(),
                now,
                8 * 3600,
            )
        }
    }

    unsafe fn commit(handle: *mut StatsHandle, text: &str, raw_code_len: i64, now: i64) -> c_int {
        unsafe {
            rime_input_stats_on_commit(
                handle,
                text.as_ptr() as *const c_char,
                text.len(),
                raw_code_len,
                now,
                8 * 3600,
            )
        }
    }

    #[test]
    fn c_abi_round_trip_accumulates_and_serializes() {
        unsafe {
            let handle = rime_input_stats_new();
            assert!(!handle.is_null());

            // 命令输入不计数
            assert_eq!(query(handle, "/rtj", 1_000), 1);
            // 正常编码：首键 → n → ni 共 3 次击键
            assert_eq!(query(handle, "n", 1_001), 0);
            assert_eq!(query(handle, "ni", 1_002), 0);
            assert_eq!(query(handle, "nih", 1_003), 0);
            // 上屏两个字，原始码长 3（自动顶屏集合 {0} → +1 = 4）
            assert_eq!(commit(handle, "你好", 3, 1_004), 0);
            assert_eq!(rime_input_stats_field(handle, 0), 1);
            assert_eq!(rime_input_stats_field(handle, 1), 2);
            assert_eq!(rime_input_stats_field(handle, 3), 3, "3 次击键结算");
            assert_eq!(rime_input_stats_field(handle, 4), 0, "间隔短不算生词");

            let text = rime_input_stats_serialize(handle);
            let rendered = CStr::from_ptr(text).to_str().unwrap().to_owned();
            rime_input_stats_string_free(text);
            assert!(rendered.contains("[\"daily\"]"));
            assert!(rendered.contains("[\"count\"] = 1"));

            // 回读：logVer 由 -1 迁移到 4
            assert_eq!(rime_input_stats_field(handle, 7), -1);
            let rendered_c = CString::new(rendered.clone()).unwrap();
            assert_eq!(
                rime_input_stats_load(
                    handle,
                    rendered_c.as_ptr(),
                    rendered.len()
                ),
                1
            );
            assert_eq!(rime_input_stats_field(handle, 7), LOG_VERSION);

            rime_input_stats_free(handle);
        }
    }

    #[test]
    fn save_happens_on_the_twenty_first_commit() {
        unsafe {
            let handle = rime_input_stats_new();
            let mut saves = 0;
            for index in 0..=SAVE_INTERVAL {
                let text = "字";
                let raw = 4;
                let should_save = commit(handle, text, raw, 2_000 + index);
                saves += should_save;
            }
            assert_eq!(saves, 1, "第 21 次上屏才落盘");
            let text = "字";
            assert_eq!(commit(handle, text, 4, 2_100), 0, "计数已归零");
            rime_input_stats_free(handle);
        }
    }

    #[test]
    fn auto_commit_set_disables_space_surcharge() {
        unsafe {
            let handle = rime_input_stats_new();
            let codes = [5_i64, 6];
            rime_input_stats_set_auto_commit(handle, codes.as_ptr(), codes.len());
            commit(handle, "五码", 5, 3_000);
            let text = rime_input_stats_serialize(handle);
            let rendered = CStr::from_ptr(text).to_str().unwrap().to_owned();
            rime_input_stats_string_free(text);
            assert!(rendered.contains("[\"codeLengths\"] = {\n\t\t\t[5] = 1,"));
            rime_input_stats_free(handle);
        }
    }

    #[test]
    fn command_entry_clears_and_switches_skins() {
        unsafe {
            let handle = rime_input_stats_new();
            commit(handle, "你好", 3, 4_000);
            assert_eq!(rime_input_stats_field(handle, 0), 1);

            let mut save = 0;
            let text = rime_input_stats_run_command(
                handle,
                "//09".as_ptr() as *const c_char,
                4,
                4_100,
                8 * 3600,
                &mut save,
            );
            assert!(!text.is_null());
            assert_eq!(CStr::from_ptr(text).to_str().unwrap(), "※ 所有统计数据已清空。");
            rime_input_stats_string_free(text);
            assert_eq!(save, 1, "清空命令要求立即落盘");
            assert_eq!(rime_input_stats_field(handle, 0), 0, "统计已清空");

            let text = rime_input_stats_run_command(
                handle,
                "//6051".as_ptr() as *const c_char,
                6,
                4_100,
                8 * 3600,
                &mut save,
            );
            assert_eq!(CStr::from_ptr(text).to_str().unwrap(), "※ 字词统计皮肤已切换至：//6051 ▲△");
            rime_input_stats_string_free(text);
            assert_eq!(rime_input_stats_field(handle, 5), 5);

            // 未识别：空指针
            let text = rime_input_stats_run_command(
                handle,
                "nihao".as_ptr() as *const c_char,
                5,
                4_100,
                8 * 3600,
                &mut save,
            );
            assert!(text.is_null());
            rime_input_stats_free(handle);
        }
    }

    #[test]
    fn report_command_renders_with_context_and_quotes() {
        unsafe {
            let handle = rime_input_stats_new();
            // 采集两条上屏（触发跨周期初始化与累计）
            query(handle, "n", 1_704_056_000);
            commit(handle, "你好世界", 6, 1_704_056_004);
            query(handle, "ni", 1_704_056_010);
            commit(handle, "你好", 3, 1_704_056_014);

            let schema = "luna_pinyin";
            let software = "Weasel";
            let version = "1.2.3";
            let device = "💻";
            rime_input_stats_set_report_context(
                handle,
                schema.as_ptr() as *const c_char,
                schema.len(),
                software.as_ptr() as *const c_char,
                software.len(),
                version.as_ptr() as *const c_char,
                version.len(),
                device.as_ptr() as *const c_char,
                device.len(),
                std::ptr::null(),
                0,
            );
            let quote = "名言一句";
            rime_input_stats_add_quote(handle, quote.as_ptr() as *const c_char, quote.len());
            assert_eq!(rime_input_stats_quote_count(handle), 1);

            let mut save = 0;
            // 风格由命令串末两位决定（§5.0）：`/rtj` → 短款
            rime_input_stats_note_report_style(handle, "/rtj".as_ptr() as *const c_char, 4);
            let text = rime_input_stats_run_command(
                handle,
                "/rtj".as_ptr() as *const c_char,
                4,
                1_704_056_020,
                8 * 3600,
                &mut save,
            );
            assert!(!text.is_null());
            let rendered = CStr::from_ptr(text).to_str().unwrap().to_owned();
            rime_input_stats_string_free(text);
            assert_eq!(save, 0, "报表不落盘");
            assert!(rendered.contains("上屏 2 次，输入 6 字"), "{rendered}");
            assert!(rendered.contains("──────"), "{rendered}");
            assert!(rendered.contains("💻・luna_pinyin"), "{rendered}");
            assert!(!rendered.contains("名言一句"), "短款不显示名言");
            assert!(!rendered.contains("脚本："), "短款不显示脚本行");

            // 长款：显示时间/平台/脚本/名言
            rime_input_stats_set_report_context(
                handle,
                schema.as_ptr() as *const c_char,
                schema.len(),
                software.as_ptr() as *const c_char,
                software.len(),
                version.as_ptr() as *const c_char,
                version.len(),
                device.as_ptr() as *const c_char,
                device.len(),
                std::ptr::null(),
                0,
            );
            rime_input_stats_note_report_style(handle, "/rtjj".as_ptr() as *const c_char, 5);
            let text = rime_input_stats_run_command(
                handle,
                "/rtjj".as_ptr() as *const c_char,
                5,
                1_704_056_020,
                8 * 3600,
                &mut save,
            );
            let long_report = CStr::from_ptr(text).to_str().unwrap().to_owned();
            rime_input_stats_string_free(text);
            assert!(long_report.contains("🚩 日统计 🚩"), "{long_report}");
            assert!(long_report.contains("2024/01/01"), "{long_report}");
            assert!(long_report.contains("UTC+08:00"), "{long_report}");
            assert!(long_report.contains("◉ 方案：luna_pinyin"), "{long_report}");
            assert!(long_report.contains("◉ 平台：💻Weasel 1.2.3"), "{long_report}");
            assert!(long_report.contains("名言一句"), "{long_report}");

            // 皮肤清单命令不需要设备类型
            let text = rime_input_stats_run_command(
                handle,
                "/pf".as_ptr() as *const c_char,
                3,
                1_704_056_020,
                8 * 3600,
                &mut save,
            );
            let skin_list = CStr::from_ptr(text).to_str().unwrap().to_owned();
            rime_input_stats_string_free(text);
            assert!(skin_list.starts_with("※ 可用皮肤列表："), "{skin_list}");
            assert!(skin_list.contains("输入 //60 或 /pf 查看皮肤列表"));

            rime_input_stats_free(handle);
        }
    }

    #[test]
    fn report_requires_known_device_type() {
        unsafe {
            let handle = rime_input_stats_new();
            commit(handle, "字", 1, 5_000);
            let mut save = 0;
            let text = rime_input_stats_run_command(
                handle,
                "/rtj".as_ptr() as *const c_char,
                4,
                5_100,
                8 * 3600,
                &mut save,
            );
            let rendered = CStr::from_ptr(text).to_str().unwrap().to_owned();
            rime_input_stats_string_free(text);
            assert_eq!(rendered, "deviceType识别失败，请设置deviceType后重新部署");
            assert_eq!(save, 0);

            // 生字词命令不检查设备类型
            let text = rime_input_stats_run_command(
                handle,
                "/sztj".as_ptr() as *const c_char,
                5,
                5_100,
                8 * 3600,
                &mut save,
            );
            let rendered = CStr::from_ptr(text).to_str().unwrap().to_owned();
            rime_input_stats_string_free(text);
            assert_eq!(rendered, "※ 未发现生字/词记录。");
            rime_input_stats_free(handle);
        }
    }

    #[test]
    fn session_settle_and_report_detection() {
        unsafe {
            let handle = rime_input_stats_new();
            assert_eq!(
                rime_input_stats_is_report_command("/rtj".as_ptr() as *const c_char, 4),
                1
            );
            assert_eq!(
                rime_input_stats_is_report_command("/qcjs".as_ptr() as *const c_char, 5),
                0
            );
            // 迁移：新建句柄 logVer = -1，ensure_current 会重置并写入 4
            assert_eq!(rime_input_stats_ensure_current(handle), 1);
            assert_eq!(rime_input_stats_field(handle, 7), LOG_VERSION);
            assert_eq!(rime_input_stats_ensure_current(handle), 0, "幂等");

            // 结算：推进一次会话样本（10 秒窗口内的 4 秒会话）
            query(handle, "n", 100);
            commit(handle, "字", 1, 104);
            rime_input_stats_settle_session(handle, 104, 8 * 3600, 1);
            let text = rime_input_stats_serialize(handle);
            let rendered = CStr::from_ptr(text).to_str().unwrap().to_owned();
            rime_input_stats_string_free(text);
            assert!(
                rendered.contains("[\"avgGaps\"] = {\n\t\t\t[1] = 4,"),
                "结算写入会话时长（秒）：{rendered}"
            );
            rime_input_stats_free(handle);
        }
    }

    #[test]
    fn settings_and_version_are_available() {
        unsafe {
            let handle = rime_input_stats_new();
            rime_input_stats_set_boggle_threshold(handle, 5);
            assert_eq!(rime_input_stats_field(handle, 5), crate::state::DEFAULT_SKIN_INDEX);
            rime_input_stats_free(handle);
        }
        let version = rime_input_stats_version();
        let text = unsafe { CStr::from_ptr(version) }.to_str().unwrap();
        assert!(text.starts_with("rime-input-stats-core"));
    }
}
