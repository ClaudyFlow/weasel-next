{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "weasel-settings-tauri",
  "version": "0.1.0",
  "identifier": "im.rime.weasel.settings.tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "小狼毫 RS 设置",
        "width": 720,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "../icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Tauri-based settings panel for weasel-rs",
    "longDescription": "Experimental settings UI for 小狼毫 RS, co-existing with the original Slint-based weasel-settings."
  }
}
