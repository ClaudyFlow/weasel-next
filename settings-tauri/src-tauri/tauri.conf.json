{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Weasel-Next Settings",
    "version":  "0.1.0",
    "identifier":  "im.rime.weasel.settings.tauri",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeDevCommand":  "pnpm dev",
                  "beforeBuildCommand":  "pnpm build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Weasel-Next 设置",
                                    "width":  720,
                                    "height":  640,
                                    "minWidth":  480,
                                    "minHeight":  360,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "msi",
                   "icon":  [
                                "../../Rime-Next/icon/weasel.ico"
                            ],
                   "category":  "Utility",
                   "shortDescription":  "Weasel-Next settings panel",
                   "longDescription":  "Weasel-Next 设置界面（Tauri 版，与 Slint 版共存）"
               }
}
