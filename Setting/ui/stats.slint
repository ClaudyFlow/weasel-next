import { ScrollView, VerticalBox } from "std-widgets.slint";

// 输入统计 —— 独立窗口（像百度输入法的「个人生涯」）
//
// 数据由 Rust 侧读 `%APPDATA%\Rime-Next\stat\stat.bin`（TIP 采集）后灌进来；
// 没有数据时全部显示 0，界面照样能打开（便于先看结构）。

// 一天的热力格
export struct StatDay {
    // 该日击键数（决定颜色深浅）
    count: int,
    // 悬停提示，例如 "2026-10-17 · 1,234 键"
    tip: string,
    // 是否今天（描边高亮）
    today: bool,
}

// 常用字/词
export struct StatWord {
    word: string,
    count: int,
}

// 一个大数字卡片
component StatCard inherits Rectangle {
    in property <string> title: "";
    in property <int> value: 0;
    in property <string> unit: "";
    in property <color> accent: #0a3afa;

    background: white;
    border-radius: 14px;
    min-height: 64px;

    VerticalLayout {
        padding: 14px;
        spacing: 2px;
        alignment: start;

        Text {
            text: root.title;
            font-size: 15px;
            color: #6b7280;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            value-text := Text {
                text: root.value;
                font-size: 28px;
                font-weight: 700;
                color: root.accent;
            }
            Text {
                text: root.unit;
                font-size: 16px;
                color: #9ca3af;
                vertical-alignment: bottom;
            }
        }
    }
}

// 可内嵌页面：设置主界面的「主页」直接放它。
export component StatsPage inherits Rectangle {
    background: #f4f5f7;
    // Rectangle 会撑满（灰底铺满），这是「灰底拉满」要求的代价；不要再改成 VerticalBox。
    // 必须限高：它嵌在设置主界面的 VerticalBox 里，不限高会按内容撑到 700px，
    // 把底部的「保存并部署 / 关闭」挤出窗口（2026-10-17 实测）。
    // 按内容高度，不留底部空白（用户 2026-10-18：下面空白删干净）
    // 之前 660 装不下「卡片 + 段位 + 热力图 + 常用字」，常用字被挤出窗口底部
    // （2026-10-17 截图实测：常用字只露出标题）。740 在 100% / 132% 缩放下都能整屏放下。
    // ── 数据（Rust 侧设置）────────────────────────────────
    in property <string> quarter-label: "";
    in property <int> today-keys: 0;
    in property <int> today-chars: 0;
    in property <int> today-speed: 0;
    in property <int> streak-days: 0;
    in property <[StatDay]> days: [];
    in property <[StatWord]> words: [];
    // 生涯段位（20 级，来自 input_statistics.lua 的 career_levels）
    in property <string> level-title: "🌱 初识键盘";
    in property <int> level: 1;
    in property <int> exp-cur: 0;
    in property <int> exp-max: 100;
    in property <float> exp-ratio: 0.0;
    in property <string> exp-next: "";
    in property <string> realm: "凡键境";
    // 加载失败时的提示（空 = 正常）
    in property <string> status: "";
    // 还没采集到数据时的解释（灰字，空 = 不显示）
    in property <string> hint: "";

    // 热力格边长：由使用方按窗口宽度算好传进来。
    // 不能在页面里写 root.width —— 格子宽度会决定卡片高度、卡片高度又决定页面高度，
    // 而页面宽度来自布局，Slint 判成绑定环直接编译失败（2026-10-19 实测）。
    // 公式：卡片内宽 = 窗口宽 − 页面 padding(14×2) − 卡片 padding(14×2) − 52 个 3px 间隙。
    in property <length> heat-cell: 20px;

    callback refresh();

    VerticalLayout {
        padding: 14px;
        // 底部只留一点点：灵感来源是页面最后一行，要贴着窗口下沿
        // （用户 2026-10-19：「文字贴紧底部」）。
        padding-bottom: 8px;
        spacing: 12px;
        alignment: start;   // 内容靠上，别把「灵感来源」推到最底

        // ── 标题行 ────────────────────────────────────────
        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "个人生涯";
                    font-size: 28px;
                    font-weight: 700;
                    color: #111827;
                }
                Text {
                    text: root.hint == "" ? "本机记录，不上传（作者本人暂时没有这个技术水平）" : root.hint;
                    font-size: 16px;
                    color: #9ca3af;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // 刷新按钮自绘：std-widgets 的 Button 在浅色卡片上是白底浅字，
            // 2026-10-17 截图里几乎看不见（只剩一个白框）。
            Rectangle {
                width: 76px;
                height: 34px;
                border-radius: 8px;
                background: white;
                border-width: 1px;
                border-color: #d1d5db;

                Text {
                    text: "刷新";
                    font-size: 15px;
                    color: #374151;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.refresh(); }
                }
            }
        }

        // ── 四个数字卡片 ──────────────────────────────────
        HorizontalLayout {
            spacing: 14px;

            StatCard {
                title: "今日击键";
                value: root.today-keys;
                unit: "次";
                horizontal-stretch: 1;
            }
            StatCard {
                title: "今日上屏";
                value: root.today-chars;
                unit: "字";
                accent: #16a34a;
                horizontal-stretch: 1;
            }
            StatCard {
                title: "平均速度";
                value: root.today-speed;
                unit: "字/分";
                accent: #d97706;
                horizontal-stretch: 1;
            }
            StatCard {
                title: "连续使用";
                value: root.streak-days;
                unit: "天";
                accent: #7c3aed;
                horizontal-stretch: 1;
            }
        }

        // ── 生涯段位 + 进度条（20 级 + 7 境界，定义来自 input_statistics.lua）────
        Rectangle {
            background: white;
            border-radius: 14px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.level-title;
                        font-size: 22px;
                        font-weight: 700;
                        color: #111827;
                    }
                    Text {
                        text: "Lv." + root.level;
                        font-size: 15px;
                        color: #f0a030;
                        font-weight: 600;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.realm;
                        font-size: 16px;
                        color: #6b7280;
                    }
                }

                // 进度条：底色 + 前景按比例撑开
                Rectangle {
                    height: 12px;
                    border-radius: 6px;
                    background: #e8eaee;
                    Rectangle {
                        width: parent.width * root.exp-ratio;
                        height: parent.height;
                        border-radius: 6px;
                        background: #f0a030;
                    }
                }

                HorizontalLayout {
                    Text {
                        text: root.exp-cur + " / " + root.exp-max + " 经验";
                        font-size: 16px;
                        color: #9ca3af;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.exp-next;
                        font-size: 16px;
                        color: #9ca3af;
                    }
                }
            }
        }

        // ── 整年热力图 ────────────────────────────────────
        Rectangle {
            background: white;
            border-radius: 14px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: root.quarter-label;
                    font-size: 15px;
                    font-weight: 600;
                    color: #374151;
                }

                // GitHub 贡献图布局：**列 = 周，行 = 星期**（7 行 × 53 列 = 371 格，整一年）
                // 数据按「周 × 7 + 星期」索引，Rust 侧保证数组补满 371 个。
                // 尺寸不再写死 17px：按 heat-cell 实时计算，横向撑满卡片（贴到两端）。
                HorizontalLayout {
                    spacing: 3px;
                    alignment: start;
                    for week in 53 : VerticalLayout {
                        spacing: 3px;
                        for day in 7 : Rectangle {
                            width: root.heat-cell;
                            height: root.heat-cell;
                            border-radius: 2px;
                            background: root.days[week * 7 + day].count <= 0
                                ? #ebedf0
                                : (root.days[week * 7 + day].count < 100
                                    ? #9be9a8
                                    : (root.days[week * 7 + day].count < 500
                                        ? #40c463
                                        : (root.days[week * 7 + day].count < 1500 ? #30a14e : #216e39)));
                            border-width: root.days[week * 7 + day].today ? 2px : 0px;
                            border-color: #1f2328;
                        }
                    }
                }

                // 图例（GitHub 同款：少 → 多 五个色块）—— 用户 2026-10-19：整行居中
                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: "少"; font-size: 15px; color: #9ca3af; vertical-alignment: center; }
                    Rectangle { width: 13px; height: 13px; border-radius: 2px; background: #ebedf0; }
                    Rectangle { width: 13px; height: 13px; border-radius: 2px; background: #9be9a8; }
                    Rectangle { width: 13px; height: 13px; border-radius: 2px; background: #40c463; }
                    Rectangle { width: 13px; height: 13px; border-radius: 2px; background: #30a14e; }
                    Rectangle { width: 13px; height: 13px; border-radius: 2px; background: #216e39; }
                    Text { text: "多"; font-size: 15px; color: #9ca3af; vertical-alignment: center; }
                    Text { text: "（<100 / <500 / <1500 / ≥1500 键）"; font-size: 16px; color: #9ca3af; vertical-alignment: center; }
                }

            }
        }

        // ── 常用字 Top ────────────────────────────────────
        // 没有字频数据时整张卡片不进布局。注意不能用 `visible: false`：
        // Slint 里那只是不画，min-height 108px + 12px 间距照样占位，
        // 会在热力图下面留一条 120px 的空灰边（2026-10-19 实测）。
        if root.words.length > 0 : Rectangle {
            background: white;
            border-radius: 14px;
            min-height: 108px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: "常用字";
                    font-size: 15px;
                    font-weight: 600;
                    color: #374151;
                }

                HorizontalLayout {
                    spacing: 10px;
                    for word in root.words : Rectangle {
                        background: #f1f5f9;
                        border-radius: 8px;
                        min-width: 54px;

                        VerticalLayout {
                            padding: 8px;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: word.word;
                                font-size: 20px;
                                font-weight: 700;
                                color: #111827;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: word.count;
                                font-size: 16px;
                                color: #6b7280;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // 灵感来源：放在页面最下方、卡片之外的灰底上（用户 2026-10-19：
        // 从热力图卡片里拿出来，落到下面那块灰色区域）。
        Text {
            text: "✨ 灵感来源：🐐🪶❄🌸 羊毛雪花 · input_statistic 统计插件";
            font-size: 14px;
            color: #9ca3af;
            horizontal-alignment: center;
        }

    }
    }
// 独立窗口包装：`/stat` 直接开这个。内容全在 StatsPage 里，这里只做属性透传。
export component StatsWindow inherits Window {
    title: "小狼毫Next · 输入统计";
    preferred-width: 1120px;
    preferred-height: 740px;
    // 热力格按窗口宽度算尺寸，窗口别缩到算出来是负数的程度；
    // 660 是 1000px 宽时「卡片 + 段位 + 热力图 + 常用字」的实际内容高度。
    min-width: 1000px;
    min-height: 660px;

    in property <int> today-keys: 0;
    in property <string> quarter-label: "";
    in property <int> today-chars: 0;
    in property <int> today-speed: 0;
    in property <int> streak-days: 0;
    in property <[StatDay]> days: [];
    in property <[StatWord]> words: [];
    in property <string> level-title: "🌱 初识键盘";
    in property <int> level: 1;
    in property <int> exp-cur: 0;
    in property <int> exp-max: 100;
    in property <float> exp-ratio: 0.0;
    in property <string> exp-next: "";
    in property <string> realm: "凡键境";
    in property <string> status: "";
    in property <string> hint: "";
    callback refresh();

    // 热力格边长：53 列 + 52 个 3px 间隙正好铺满卡片内宽（贴到两端）。
    // 用 init / changed width 赋值而不是属性绑定 —— 绑定的话「格子宽 → 卡片高 →
    // 页面宽 → 格子宽」会被 Slint 判成绑定环（2026-10-19 编译实测）。
    in-out property <length> heat-cell: 20px;
    init => { root.heat-cell = (root.width - 212px) / 53; }
    changed width => { root.heat-cell = (root.width - 212px) / 53; }

    StatsPage {
        quarter-label: root.quarter-label;
        // 格子尺寸由窗口算好传进来（见 StatsWindow 的 changed width）。
        heat-cell: root.heat-cell;
        today-keys: root.today-keys;
        today-chars: root.today-chars;
        today-speed: root.today-speed;
        streak-days: root.streak-days;
        days: root.days;
        words: root.words;
        level-title: root.level-title;
        level: root.level;
        exp-cur: root.exp-cur;
        exp-max: root.exp-max;
        exp-ratio: root.exp-ratio;
        exp-next: root.exp-next;
        realm: root.realm;
        status: root.status;
        hint: root.hint;
        refresh => { root.refresh(); }
    }
}
















