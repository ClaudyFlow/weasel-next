import { Button, VerticalBox, HorizontalBox, ComboBox, ScrollView, LineEdit, TextEdit, Switch, Palette } from "std-widgets.slint";
// ColorScheme 是内建枚举（不需要 import）；上一棒从 std-widgets.slint 导它 → 编译报
// "No exported type called 'ColorScheme'"，2026-10-19 实测。
import { AppOptions, AppEntry, IconAction } from "app-options.slint";
import { ColorEditor } from "color-editor.slint";
import { WasmModules, WasmEntry } from "wasm-modules.slint";
import { ColorSchemesPage, SchemeRow } from "color-schemes.slint";
import { SchemaPicker, SchemaRow, SeriesNav } from "schemas.slint";
import { StatsPage, StatDay, StatWord, CloudWord } from "stats.slint";
import { DictPage, DictRow } from "dicts.slint";
import { DownloadPage, RepoRow } from "download.slint";
export { StatsWindow, StatDay, StatWord, CloudWord } from "stats.slint";
export { DeployProgressWindow } from "progress.slint";
export { ColorCodec } from "color-editor.slint";
export struct SettingField { source-index: int, category: int, section: string, shown: bool, title: string, key: string, description: string, choices: [string], selected: int, checked: bool, text: string, text-input: bool, boolean: bool, overridden: bool, enum-number: bool, color-input: bool, allow-system-color: bool, adaptive-color: bool, multiline: bool }
export struct NavItem { label: string, idx: int }
export component SettingsWindow inherits Window {
    title: "小狼毫Next：设置";
    default-font-family: "Segoe UI";
    in property <bool> mica-enabled: false;
    // 玻璃只做「外壳」：标题栏/标签栏底下透出浅色亚克力，内容页与卡片保持不透明（可读性优先）。
    // 87% 白：既能看到背后模糊，又不会被深色窗口衬成一片灰（2026-10-28 用户否掉了全透明版）。
    background: mica-enabled ? #ffffffdd : #ffffff;
    // 白底必须配浅色主题，否则 Palette.foreground 还是深色主题的白色 → 白底白字。
    icon: @image-url("../../Rime-Next/icon/weasel.ico");
    // 用户 2026-11-01 21:3x：定 1280×720（标准 16:9）
    preferred-width: 1280px;
    // 高度贴着内容收：再少一点统计页就装不下，再多一点底部又会多出一条空灰边。
    preferred-height: 720px;
    min-width: 1000px;
    min-height: 500px;
    in property <string> status;
    in property <bool> editable;
    in property <bool> dirty;
    in property <[SettingField]> fields;
    in property <[SettingField]> visible-fields;
    // 当前页签该显示的字段行（Rust 侧 `refresh_page_fields` 筛好）。
    // 不能改用 `for … { if … }` 在界面上过滤：空行仍参与父布局的 spacing，
    // 内容少的页会白裂几百像素（2026-10-18 实测）。
    in property <[SettingField]> page-fields;
    callback page-selected(int);
    in property <bool> invalid;
    in property <bool> update-available: false;
    in-out property <bool> update-checked: false;
    in property <string> update-status: "正在读取更新设置…";
    private property <string> new-app-name;
    in-out property <string> app-add-error;
    in property <[AppEntry]> apps;
    in property <[WasmEntry]> wasm-modules;
    in property <[SchemeRow]> schemes;
    in property <string> active-scheme;
    in property <string> scheme-status;
    in property <color> scheme-preview-back: #eceeee;
    in property <color> scheme-preview-border: #b0b0b0;
    in property <color> scheme-preview-text: #0f172a;
    in property <color> scheme-preview-hilited-back: #fa3a0a;
    in property <color> scheme-preview-hilited-text: #ffffff;
    in property <color> scheme-preview-comment: #888888;
    callback scheme-picked(string);
    callback scheme-refresh();
    // 候选窗材质三档（2026-11-02）：0=透明 1=亚克力 2=默认（原来叫"不透明"，
    // 2026-11-04 10:50 用户要求改成"默认"：这档就是主题本来的样子）。
    // 界面只负责显示与回调，写文件在 Rust 侧（`weasel_settings::material`）；
    // 主题运行时读同一个文件（`theme/src/paint.rs::tier`），切完下一次按键生效。
    in-out property <int> candidate-material: 0;
    in property <string> material-status: "";
    callback material-picked(int);
    // 方案选单页（Rust 侧读 `weasel_style::switcher`，与官方对话框同一份数据）
    in property <[SchemaRow]> schema-rows;
    in property <[SeriesNav]> series-nav;
    in property <string> schema-status;
    callback schema-toggle(string);
    callback schema-series-toggled(string);
    callback schema-series-select(string);
    callback dict-find();
    callback dict-add();
    callback dict-remove();
    callback dict-refresh();
    callback download-tab-selected(string);
    callback download-install(string);
    callback download-dismiss-net();
    callback schema-apply();
    callback schema-refresh();
    callback schema-open-dialog();
    callback module-action(string, string, string, string) -> string;
    callback app-add(string) -> bool;
    callback app-remove(string);
    callback app-edit(string, string, bool, bool);
    callback changed(int, int, string);
    callback update-changed(bool);
    callback loaded();
    callback save(bool);
    callback request-close();
    // 托盘菜单里的两项收进主界面：两个都是官方模板的 Win32 对话框，
    // ── 左侧标签栏 + 「主页」= 个人记录（用户 2026-10-17 要求）────────────
    in-out property <int> current-page: 0;
    in property <[NavItem]> nav-items: [
        { label: "主页", idx: 0 },
        { label: "界面风格", idx: 1 },
        { label: "方案选单", idx: 2 },
        { label: "常规", idx: 3 },
        // 「应用选项」「外观与行为」两页已删除（用户 2026-10-18 要求）：
        // 前者是 app_options（按程序覆盖输入模式），后者只有启用了带配置的主题才有内容，
        // 平时都是空页。数据层没删，只是不再占页签。
        { label: "更新", idx: 4 },
        { label: "词库", idx: 5 },
        { label: "下载", idx: 6 }
    ];
    // 统计页的数据（Rust 侧灌；未接数据时全 0）
    in property <int> stat-today-keys: 0;
    in property <int> stat-today-chars: 0;
    in property <int> stat-total-chars: 0;
    in property <int> stat-best-speed: 0;
    in property <int> stat-today-speed: 0;
    // 今日击键速度（键/秒，已格式化成一位小数）
    in property <string> stat-today-key-speed-text: "0.0";
    // 历史均速 / 历史极速的小字
    in property <string> stat-all-speed-note: "";
    in property <string> stat-best-speed-note: "";
    // 击键秒速：历史最大 / 历史平均
    in property <string> stat-best-key-speed-text: "0.0";
    in property <string> stat-all-key-speed-note: "";
    in property <string> stat-best-key-speed-note: "";
    in property <string> stat-total-chars-note: "";
    in property <string> stat-best-streak-note: "";
    in property <string> stat-total-keys-note: "";
    in property <string> stat-code-len-text: "0.00";
    in property <string> stat-all-code-len-note: "";
    // 键准 / 平均词长：今日值 + 灰色历史值（用户 2026-10-26）
    in property <string> stat-key-accuracy-text: "0.0";
    in property <string> stat-key-accuracy-note: "";
    in property <string> stat-word-len-text: "0.00";
    in property <string> stat-word-len-note: "";
    // 打字时间：今日 / 累计有效输入时长（分钟，Rust 侧格式化好）
    in property <string> stat-time-today-text: "0";
    in property <string> stat-time-total-note: "";
    // 平均每日字数：全期 / 近 7 天
    in property <string> stat-avg-daily-text: "0";
    in property <string> stat-avg-daily-note: "";
    in property <int> stat-total-keys: 0;
    in property <int> stat-streak-days: 0;
    in property <[StatDay]> stat-days: [];
    // 年度活跃记录（12 月 × 7 天，Rust 侧聚合好）
    in property <[StatDay]> stat-month-days: [];
    in property <int> stat-active-days: 0;
    in property <int> stat-active-rate: 0;
    // 12 个月各自起始周（列索引），给月份标签定位
    in property <[int]> stat-month-week: [];
    in property <[StatDay]> stat-calendar: [];
    in property <[int]> stat-calendar-cols: [];
    in property <[int]> stat-calendar-offsets: [];
    in property <[int]> stat-calendar-mask: [];
    // 网格总列数（各月周数之和）：格子边长按它精确算，别再用估的分母
    in property <int> stat-calendar-cols-total: 53;
    in property <[StatWord]> stat-words: [];
    // 词云排版（Rust 侧算好坐标）
    in property <[CloudWord]> stat-cloud: [];
    // 词云来源说明（"1260 个学词 · 来自 2 个方案的用户词典"）
    in property <string> stat-cloud-note: "";
    in property <[StatWord]> stat-words2: [];
    in property <[StatWord]> stat-words3: [];
    // 键盘热力图 / 码长直方图（stat.bin 尾部扩展；老文件为空）
    in property <[int]> stat-key-counts: [];
    // 时段统计（24 个小时桶，0..100 百分比）
    in property <[int]> stat-hour-keys: [];
    in property <int> stat-hour-peak: 0;
    in property <string> stat-hour-summary: "";
    // 词库页
    in property <[DictRow]> dict-rows;
    in property <string> dict-status: "";
    in-out property <string> dict-code: "";
    in-out property <string> dict-word: "";
    // 下载页
    in property <[RepoRow]> download-repos;
    in property <[string]> download-categories;
    in-out property <string> download-active-tab: "全部";
    in property <string> download-installing-name: "";
    in property <string> download-installed-name: "";
    in property <string> download-net-error: "";
    in property <float> download-frac: 0.0;
    in property <string> download-list-status: "";
    in property <[int]> stat-code-lens: [];
    in property <int> stat-key-peak: 1;
    in property <string> stat-finger-hands: "—";
    in property <string> stat-finger-rows: "—";
    in property <string> stat-finger-names: "—";
    in property <string> stat-level-title: "";
    in property <int> stat-level: 1;
    in property <int> stat-exp-cur: 0;
    in property <int> stat-exp-max: 100;
    in property <float> stat-exp-ratio: 0.0;
    in property <string> stat-exp-next: "";
    in property <string> stat-realm: "";
    // 名著字数水平（趣味对照，Rust 侧按累计上屏字数算好）
    in property <string> stat-book-note: "";
    in property <string> stat-status: "";
    // Rust 侧用自身进程加 `/switcher`、`/style` 再起一个。
    in property <string> stat-quarter-label: "";
    // 今日格在年度热力图里的坐标（-1 = 今天不在网格里，不画十字高亮）。
    in property <int> stat-today-week: -1;
    in property <int> stat-today-day: -1;
    // 主页热力格边长：53 列 + 52 个 3px 间隙铺满卡片内宽（贴到两端）。
    // 用 init / changed width 赋值而非属性绑定，绑定会和布局形成绑定环（编译实测）。
    private property <length> stats-heat-cell: 20px;
    // 底色全部写死浅色（#ffffff 卡片 / #f5f7fa 页面），调色板必须一起钉在浅色。
    // 系统是深色时 Palette.foreground 会是白的，设置页整片白底白字、看着像空白页
    // （2026-10-19 实测）。
    init => { self.stats-heat-cell = (self.width - 340px) / Math.max(self.stat-calendar-cols-total, 40); Palette.color-scheme = ColorScheme.light; }
    changed width => { self.stats-heat-cell = (self.width - 340px) / Math.max(self.stat-calendar-cols-total, 40); }
    // 数据晚到：总列数变了要重算格子边长（不然 init 时用的还是默认 53）
    changed stat-calendar-cols-total => { self.stats-heat-cell = (self.width - 340px) / Math.max(self.stat-calendar-cols-total, 40); }
    callback open-switcher();
    callback open-style();
    VerticalBox {
        // 左右 padding 归零：让「主页」的灰底（StatsPage）能横向铺满整个窗口，
        // 各子块自己带 padding（用户 2026-10-18：宽度拉满，没到也拉满，后面渲染成灰色）。
        padding: 0px;
        padding-top: 8px;
        spacing: 12px;
        HorizontalBox {
            height: 48px;
            padding: 0px;
            padding-left: 24px;
            // 给 DWM 原生标题栏按钮区域留出空间。
            padding-right: 144px;
            Text { color: #17202b; text: "小狼毫Next 设置"; font-size: 22px; vertical-alignment: center; }
        }
        // ── 标签栏（用户要求：第一个叫「主页」，就是个人记录）──────────────
        HorizontalBox {
            height: 34px;
            padding: 0px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 4px;

            // 页签区改成绝对定位：选中底要能横向滑动（用户 2026-10-26：
            // 「做一个那种高级的标签滑动切换效果，界面不用动画，只要标签就行」）。
            // 宽度 = n×96 + (n−1)×4 间距；每个页签步长 100px（96 + 4）。
            // ⚠️ 只给这一块的 `x` 加 animate，页面内容（StatsPage 等）**不参与**动画，
            // 点页签仍然是瞬时切换。
            Rectangle {
                width: root.nav-items.length * 96px + (root.nav-items.length - 1) * 4px;
                height: 34px;
                background: transparent;

                // 选中底：跟着 current-page 平移。
                // 用户 2026-10-26 第二轮：「不够高级，neovide 的动画效果，或者 vscode animation，
                // 要有跳跃感」→ 用 easeOutBack 曲线（前段冲过头、末端回弹）+ 260ms，
                // 而不是 ease-in-out 那种"平移"感。Slint 只给 cubic-bezier，
                // Neovide 的弹簧阻尼曲线用 (0.34, 1.56, 0.64, 1) 近似：y>1 就是冲过目标再弹回。
                // 底下一层很浅的投影让它像一块实心薄片在滑，而不是色块切换。
                Rectangle {
                    x: root.current-page * 100px;
                    y: 0px;
                    width: 96px;
                    height: 32px;
                    border-radius: 6px;
                    background: #e4e7ec;
                    drop-shadow-color: #0f172a1f;
                    drop-shadow-blur: 6px;
                    drop-shadow-offset-y: 1px;
                    animate x { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                }

                // 文字与热区画在选中底上面。未选中的悬停/按下是实色，正好盖住底下没有东西的部分；
                // 选中项只有按下时才盖一层更深的，平时保持透明让滑动底露出来。
                for item in root.nav-items : Rectangle {
                    x: item.idx * 100px;
                    y: 0px;
                    width: 96px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.current-page == item.idx
                        ? (ta.pressed ? #cfd6df : transparent)
                        : (ta.pressed ? #e2e8ef : (ta.has-hover ? #eef1f5 : transparent));
                    Text {
                        text: item.label;
                        font-size: 14px;
                        color: root.current-page == item.idx ? #17202b : (ta.has-hover ? #334155 : #57606a);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        // 文字颜色跟着底一起渐变（选中变深、取消变浅），跳一下但不闪。
                        animate color { duration: 200ms; easing: ease-out; }
                    }
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.current-page = item.idx; root.page-selected(item.idx); }
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }
            // 操作按钮放在标签栏右侧：不占额外高度，底部也就不会多出一条操作条。
            // std-widgets 的 Button 在白底上是白底白字（几乎看不见），所以自绘。
            // 自绘就得自己给悬停/按下反馈（用户 2026-10-26）。
            Rectangle {
                width: 104px;
                height: 28px;
                border-radius: 6px;
                background: root.editable && !root.invalid
                    ? (save-ta.pressed ? #d7dfe9 : (save-ta.has-hover ? #f1f5f9 : white))
                    : white;
                border-width: 1px;
                border-color: save-ta.pressed ? #8fa0b4 : #c9d2de;
                Text {
                    text: "保存并部署";
                    font-size: 13px;
                    color: root.editable && !root.invalid ? #334155 : #c0c4cc;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                save-ta := TouchArea {
                    mouse-cursor: root.editable && !root.invalid ? pointer : default;
                    clicked => { if (root.editable && !root.invalid) { root.save(true); } }
                }
            }
            Rectangle {
                width: 64px;
                height: 28px;
                border-radius: 6px;
                background: close-ta.pressed ? #d7dfe9 : (close-ta.has-hover ? #f1f5f9 : white);
                border-width: 1px;
                border-color: close-ta.pressed ? #8fa0b4 : #c9d2de;
                Text {
                    text: "关闭";
                    font-size: 13px;
                    color: close-ta.pressed ? #0f172a : #334155;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                close-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.request-close(); }
                }
            }
        }

        // 顶部状态文字整行删掉（用户 2026-10-18：「已切换到 xxx」这行不要显示）。
        // 它以前既显示切换配色的结果、也显示保存/报错；现在这些结果改由各自页面里的
        // 状态行表达（配色页有「37 套配色 · 当前 xxx」，方案页有「N 个可用方案」）。

        // ── 主页：个人记录（统计页，可直接内嵌）──────────────────────────
        // 页面是 VerticalBox 的最后一个子项并且吃掉剩余高度：窗口再高，
        // 多出来的也是页面灰底本身，不会出现「白条」。
        // 用 if 而不是 visible：Slint 里 visible:false 只是不画，布局位置照占，
        // 会和「设置页」互相挤占空间。
        if root.current-page == 0 : StatsPage {
            today-keys: root.stat-today-keys;
            // 主页横向 padding 为 0，页面宽 = 窗口宽；53 列 + 52 个 3px 间隙刚好铺满卡片。
            heat-cell: root.stats-heat-cell;
            quarter-label: root.stat-quarter-label;
            today-week: root.stat-today-week;
            today-day: root.stat-today-day;
            today-chars: root.stat-today-chars;
            total-chars: root.stat-total-chars;
            best-speed: root.stat-best-speed;
            today-speed: root.stat-today-speed;
            today-key-speed-text: root.stat-today-key-speed-text;
            all-speed-note: root.stat-all-speed-note;
            best-speed-note: root.stat-best-speed-note;
            best-key-speed-text: root.stat-best-key-speed-text;
            all-key-speed-note: root.stat-all-key-speed-note;
            best-key-speed-note: root.stat-best-key-speed-note;
            total-chars-note: root.stat-total-chars-note;
            best-streak-note: root.stat-best-streak-note;
            total-keys-note: root.stat-total-keys-note;
            code-len-text: root.stat-code-len-text;
            all-code-len-note: root.stat-all-code-len-note;
            key-accuracy-text: root.stat-key-accuracy-text;
            key-accuracy-note: root.stat-key-accuracy-note;
            word-len-text: root.stat-word-len-text;
            word-len-note: root.stat-word-len-note;
            time-today-text: root.stat-time-today-text;
            time-total-note: root.stat-time-total-note;
            avg-daily-text: root.stat-avg-daily-text;
            avg-daily-note: root.stat-avg-daily-note;
            total-keys: root.stat-total-keys;
            streak-days: root.stat-streak-days;
            days: root.stat-days;
            month-days: root.stat-month-days;
            active-days: root.stat-active-days;
            active-rate: root.stat-active-rate;
            month-week: root.stat-month-week;
            calendar: root.stat-calendar;
            calendar-cols: root.stat-calendar-cols;
            calendar-offsets: root.stat-calendar-offsets;
            calendar-mask: root.stat-calendar-mask;
            words: root.stat-words;
            cloud: root.stat-cloud;
            cloud-note: root.stat-cloud-note;
            words2: root.stat-words2;
            words3: root.stat-words3;
            key-counts: root.stat-key-counts;
            hour-keys: root.stat-hour-keys;
            hour-peak: root.stat-hour-peak;
            hour-summary: root.stat-hour-summary;
            code-lens: root.stat-code-lens;
            key-peak: root.stat-key-peak;
            finger-hands: root.stat-finger-hands;
            finger-rows: root.stat-finger-rows;
            finger-names: root.stat-finger-names;
            level-title: root.stat-level-title;
            level: root.stat-level;
            exp-cur: root.stat-exp-cur;
            exp-max: root.stat-exp-max;
            exp-ratio: root.stat-exp-ratio;
            exp-next: root.stat-exp-next;
            realm: root.stat-realm;
            book-note: root.stat-book-note;
            status: root.stat-status;
        }
        // ── 界面风格（tab 1）：配色方案页（官方 /style 对话框的 Slint 版）────────
        // 整页给 ColorSchemesPage，列表才能吃满剩余高度；塞在设置页的 ScrollView 里
        // 时没有确定高度，内部配色列表会塌成一行（memo 里记过这个坑）。
        if root.current-page == 1 : VerticalLayout {
            padding: 12px;
            padding-top: 0px;
            spacing: 8px;
            // ── 候选窗材质三档（2026-11-02）────────────────────────────────
            // 写 `%APPDATA%\Rime-Next\theme\material.txt`；主题运行时读它，
            // 所以不需要重装/换 DLL ——「一个 DLL 三档全包」。
            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: "候选窗材质";
                    font-size: 13px;
                    color: #374151;
                    width: 84px;
                    vertical-alignment: center;
                }
                for tier in [
                    { label: "透明", idx: 0 },
                    { label: "亚克力", idx: 1 },
                    { label: "默认", idx: 2 }
                ] : Button {
                    width: 92px;
                    height: 30px;
                    text: tier.label;
                    primary: root.candidate-material == tier.idx;
                    clicked => {
                        root.candidate-material = tier.idx;
                        root.material-picked(tier.idx);
                    }
                }
                // 「材质 → 透明（打一次字生效）」那条提示已去掉（用户 2026-11-04 10:25）：
                // 换档本来下一次按键就生效，没什么好提示的。这里只保留**写文件失败**
                // 这类真错误，正常情况一个字都不显示。
                if root.material-status != "" : Text {
                    text: root.material-status;
                    font-size: 12px;
                    color: #b91c1c;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if root.schemes.length > 0 : ColorSchemesPage {
                schemes: root.schemes;
                active-id: root.active-scheme;
                status: root.scheme-status;
                editable: root.editable;
                preview-back: root.scheme-preview-back;
                preview-border: root.scheme-preview-border;
                preview-text: root.scheme-preview-text;
                preview-hilited-back: root.scheme-preview-hilited-back;
                preview-hilited-text: root.scheme-preview-hilited-text;
                preview-comment: root.scheme-preview-comment;
                picked(id) => { root.scheme-picked(id); }
                refresh() => { root.scheme-refresh(); }
            }
            // 一条配色都读不到时别留一整页空白，说清楚是路径问题。
            if root.schemes.length == 0 : Text {
                text: "没有读到任何配色：检查程序文件夹的 Rime-Next/theme 与用户目录的 theme。";
                font-size: 13px;
                color: #4b5563;
                wrap: word-wrap;
            }
        }
        // ── 方案选单（tab 2）：可用方案列表 + 勾选 + 保存并部署（官方 /switcher 的 Slint 版）──
        if root.current-page == 2 : VerticalLayout {
            padding: 12px;
            padding-top: 0px;
            spacing: 8px;
            SchemaPicker {
                rows: root.schema-rows;
                status: root.schema-status;
                editable: root.editable;
                toggled(id) => { root.schema-toggle(id); }
                    series-toggled(s) => { root.schema-series-toggled(s); }
                    series-nav: root.series-nav;
                    series-select(s) => { root.schema-series-select(s); }
                apply() => { root.schema-apply(); }
                refresh() => { root.schema-refresh(); }
                open-dialog() => { root.schema-open-dialog(); }
            }
        }
        // ── 其余页签：原来的设置界面（字段表单）────────────────────────
        if root.current-page >= 3 : VerticalLayout {
            padding: 20px;
            padding-top: 0px;
            spacing: 8px;
            // 用户 2026-10-18：不要显示那一行 `C:\Users\…\weasel.custom.toml` 路径。
            ScrollView {
                // 不显示水平滚动条（用户 2026-11-04 11:0x）：窗口窄了也不该出现横条。
                horizontal-scrollbar-policy: always-off;
                VerticalBox {
                    // 剩余高度不能分给子项：默认 alignment: stretch 会把空白的
                    // 字段行/标题块按比例撑开，「应用选项」「更新」这种内容少的页
                    // 就在标题与卡片之间裂出一大段空白（实测截图）。
                    alignment: start;
                    padding: 0px;
                    // 为浮动滚动条预留空间，避免覆盖卡片和右侧按钮。
                    padding-right: 14px;
                    spacing: 0px;
                    // 行间距靠行内 padding，不靠父布局 spacing（spacing: 0 见下）。
                    for field in root.page-fields: VerticalBox {
                        if true : VerticalBox {
                            padding: 0px;
                            padding-top: 6px;
                            spacing: 8px;
                            if field.section != "": VerticalBox {
                                padding: 0px;
                                padding-top: field.section == "常规" ? 0px : 20px;
                                spacing: 0px;
                                Text { text: field.section; font-size: 20px; font-weight: 600; }
                            }
                            if field.key == "app_options": AppOptions {
                                enabled: root.editable;
                                entries: root.apps;
                                add() => { root.new-app-name = ""; root.app-add-error = ""; add-popup.show(); }
                                remove(name) => { root.app-remove(name); }
                                edit(name, key, value, reset) => { root.app-edit(name, key, value, reset); }
                            }
                            if field.key == "modules": WasmModules {
                                enabled: root.editable;
                                entries: root.wasm-modules;
                                action(kind, id, key, value) => { return root.module-action(kind, id, key, value); }
                            }
                            if field.multiline && field.key != "app_options" && field.key != "modules" && field.key != "color_schemes": Rectangle {
                                background: Palette.control-background;
                                border-radius: 6px;
                                vertical-stretch: 0;
                                VerticalBox {
                                    padding: 16px; spacing: 10px;
                                    HorizontalBox {
                                        padding: 0px; spacing: 12px;
                                        VerticalBox {
                                            padding: 0px; spacing: 4px;
                                            Text { text: field.title; font-size: 17px; font-weight: 600; }
                                            Text { text: field.key; font-size: 12px; opacity: 0.65; }
                                            Text { text: field.description; font-size: 12px; wrap: word-wrap; opacity: 0.75; }
                                        }
                                        IconAction {
                                            icon: @image-url("reset_settings.svg");
                                            label: "恢复继承";
                                            enabled: root.editable && field.overridden;
                                            clicked => { root.changed(field.source-index, 0, ""); }
                                        }
                                    }
                                    TextEdit {
                                        height: 120px;
                                        enabled: root.editable;
                                        text <=> field.text;
                                        edited => { root.changed(field.source-index, 1, self.text); }
                                    }
                                }
                            }
                            if !field.multiline && field.key != "app_options" && field.key != "modules": Rectangle {
                              vertical-stretch: 0;
                              border-radius: 6px;
                              background: Palette.control-background;
                              border-width: 1px;
                              border-color: Palette.foreground.with-alpha(0.08);
                            HorizontalBox {
                              padding: 16px;
                              spacing: 12px;
                              VerticalBox {
                                padding: 0px;
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text { text: field.title; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                                Text { text: field.key; font-size: 12px; opacity: 0.65; wrap: word-wrap; }
                                if field.description != "": Text { text: field.description; font-size: 12px; opacity: 0.75; wrap: word-wrap; }
                              }
                              if field.color-input: ColorEditor {
                                allow-system: field.allow-system-color;
                                adaptive: field.adaptive-color;
                                min-height: 32px;
                                enabled: root.editable;
                                value: field.text;
                                edited(value) => { root.changed(field.source-index, 1, value); }
                              }
                              if !field.color-input: Rectangle {
                                width: field.enum-number && field.selected == field.choices.length - 1 ? 250px : field.boolean ? 44px : field.text-input ? 210px : 160px;
                                min-height: 32px;
                                horizontal-stretch: 0;
                            HorizontalLayout {
                                width: parent.width;
                                height: 32px;
                                y: (parent.height - self.height) / 2;
                                spacing: 10px;
                                padding: 0px;
                            if field.boolean: Switch {
                                width: 44px;
                                height: 32px;
                                enabled: root.editable;
                                checked <=> field.checked;
                                vertical-stretch: 0;
                                toggled => { root.changed(field.source-index, self.checked ? 2 : 1, ""); }
                            }
                            if !field.boolean && !field.text-input: ComboBox {
                                width: 160px;
                                height: 32px;
                                enabled: root.editable;
                                model: field.choices;
                                current-index <=> field.selected;
                                vertical-stretch: 0;
                                horizontal-stretch: 0;
                                selected(value) => { root.changed(field.source-index, self.current-index + 1, field.text); }
                            }
                            if field.text-input: LineEdit {
                                width: parent.width;
                                height: 32px;
                                enabled: root.editable;
                                preferred-width: 210px;
                                vertical-stretch: 0;
                                horizontal-stretch: 0;
                                text <=> field.text;
                                edited => { root.changed(field.source-index, 1, self.text); }
                            }
                            if field.enum-number && field.selected == field.choices.length - 1: LineEdit {
                                width: 80px;
                                height: 32px;
                                enabled: root.editable;
                                input-type: decimal;
                                text <=> field.text;
                                edited => { root.changed(field.source-index, field.choices.length, self.text); }
                            }
                            }
                              }
                              Rectangle {
                                width: 32px;
                                min-height: 32px;
                                horizontal-stretch: 0;
                              reset := Button {
                                y: (parent.height - self.height) / 2;
                                enabled: root.editable && field.overridden;
                                width: 32px;
                                height: 32px;
                                vertical-stretch: 0;
                                horizontal-stretch: 0;
                                accessible-label: "清除覆盖，恢复继承";
                                clicked => { root.changed(field.source-index, 0, ""); }
                              }
                              Image {
                                source: @image-url("reset_settings.svg");
                                width: 18px;
                                height: 18px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Palette.foreground;
                                opacity: reset.enabled ? 0.8 : 0.3;
                                accessible-role: none;
                              }
                              }
                            }
                            }
                        }
                    }
                    if root.current-page == 4 : VerticalBox {
                        padding: 0px;
                        padding-top: 20px;
                        spacing: 8px;
                        Text { text: "其他"; font-size: 20px; font-weight: 600; }
                        Rectangle {
                            vertical-stretch: 0;
                            border-radius: 6px;
                            background: Palette.control-background;
                            border-width: 1px;
                            border-color: Palette.foreground.with-alpha(0.08);
                            HorizontalBox {
                                padding: 16px;
                                spacing: 12px;
                                VerticalBox {
                                    padding: 0px;
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text { text: "自动检查更新"; font-size: 17px; font-weight: 600; }
                                    Text { text: "WinSparkle · 当前用户"; font-size: 12px; opacity: 0.65; }
                                    Text {
                                        text: root.update-status != "" ? root.update-status : "定期检查新版本。";
                                        font-size: 12px;
                                        opacity: 0.75;
                                        wrap: word-wrap;
                                    }
                                }
                                Switch {
                                    width: 44px;
                                    height: 32px;
                                    enabled: root.editable && root.update-available;
                                    checked <=> root.update-checked;
                                    toggled => { root.update-changed(self.checked); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 词库（tab 5）：查编码 / 加词 / 删词 ──────────────────────────
        // ⚠️ 两个都踩过：
        //  1) 它以前和 VerticalBox 同级（Window 的直接子项），从窗口 (0,0) 开始画，
        //     标题行、标签栏都被词库页文字压住（2026-10-26 截图实测）。
        //  2) 只把它塞进 VerticalBox 还不够：DictPage 是**组件**，作为布局子项不吃剩余高度，
        //     内容会被挤到中间、上下各留一大片白。套一层 ScrollView（和「主页」的 StatsPage
        //     同款结构）之后内容才从顶部开始排、超出才滚动。
    }
    // ── 词库（tab 5）：查编码 / 加词 / 删词 ──────────────────────────
    // ⚠️ 这一页**不能**放进上面的 VerticalBox：它内容比窗口矮，进布局就会当作可拉伸项
    // 被推到下半屏（ScrollView / VerticalLayout / alignment: start / 写死高度 全试过，
    // 2026-10-26 逐次截图实测）。这里按窗口坐标绝对摆放，y = 顶部留白 8 + 标题 48
    // + 间距 12 + 标签栏 34 + 间距 12 = 114。
    if root.current-page == 5 : DictPage {
        x: 0px;
        y: 114px;
        width: root.width;
        height: root.height - 114px;
        rows: root.dict-rows;
        status: root.dict-status;
        code-input <=> root.dict-code;
        word-input <=> root.dict-word;
        find => { root.dict-find(); }
        add => { root.dict-add(); }
        remove => { root.dict-remove(); }
        refresh => { root.dict-refresh(); }
    }
    // ── 下载（tab 6）：方案市场，浏览 GitHub Rime-Next 组织并一键安装 ──
    if root.current-page == 6 : DownloadPage {
        x: 0px;
        y: 114px;
        width: root.width;
        height: root.height - 114px;
        repos: root.download-repos;
        categories: root.download-categories;
        active-tab <=> root.download-active-tab;
        installing-name: root.download-installing-name;
        installed-name: root.download-installed-name;
        net-error: root.download-net-error;
        download-frac: root.download-frac;
        list-status: root.download-list-status;
        tab-selected(cat) => { root.download-tab-selected(cat); }
        install(name) => { root.download-install(name); }
        dismiss-net() => { root.download-dismiss-net(); }
    }
    add-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 420px;
        height: 240px;
        close-policy: no-auto-close;
        Rectangle {
            // 控件底色含透明度；独立弹窗需要不透明的窗口底色。
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.15);
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text { color: #17202b; text: "添加应用"; font-size: 20px; font-weight: 600; }
                app-name := LineEdit {
                    placeholder-text: "程序文件名，例如 notepad.exe";
                    text <=> root.new-app-name;
                    edited => { root.app-add-error = ""; }
                    init => { self.focus(); }
                }
                Text {
                    color: #17202b;
                    text: root.app-add-error == "" ? "请输入程序文件名（例如 notepad.exe），不要包含路径。" : root.app-add-error;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalBox {
                    alignment: end;
                    Button { text: "取消"; clicked => { add-popup.close(); } }
                    Button {
                        text: "添加"; enabled: app-name.text != "";
                        clicked => { if root.app-add(app-name.text) { add-popup.close(); } }
                    }
                }
            }
        }
    }
}











