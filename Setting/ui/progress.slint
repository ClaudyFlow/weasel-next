import { Button, ProgressIndicator } from "std-widgets.slint";

// 部署 / 升级进度窗口
//
// 为什么要单独一个窗口：部署是由 broker 执行的（引擎单实例，Setting 自己拉不起来），
// Setting 这边只能"发命令 + 轮询完成标志"，中间没有任何回调。
// 所以这个窗口做两件事：
//   1. 把**阶段**显示出来（停进程 / 编译方案 / 同步文件 / 重启），让用户知道没卡死
//   2. 轮询 `user.yaml` 的 `var/last_build_time`，变了就说明部署完成

export component DeployProgressWindow inherits Window {
    title: "小狼毫Next · 部署";
    width: 460px;
    height: 210px;
    background: #f4f5f7;

    in-out property <float> progress: 0.0;
    in-out property <string> stage: "准备中…";
    in-out property <string> detail: "";
    // 完成/失败后允许关闭
    in property <bool> finished: false;
    in property <bool> failed: false;

    callback cancel();

    Rectangle {
        background: white;
        border-radius: 14px;

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            Text {
                text: root.failed ? "部署失败" : (root.finished ? "部署完成" : "正在重新部署");
                font-size: 18px;
                font-weight: 600;
                color: root.failed ? #b91c1c : (root.finished ? #15803d : #111827);
            }

            Text {
                text: root.stage;
                font-size: 13px;
                color: #374151;
            }

            ProgressIndicator {
                progress: root.progress;
                indeterminate: root.progress <= 0.0 && !root.finished;
            }

            Text {
                text: root.detail;
                font-size: 11px;
                color: #9ca3af;
                wrap: word-wrap;
                min-height: 30px;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                Button {
                    text: root.finished || root.failed ? "关闭" : "取消";
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}

