{
  "formatVersion": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "weasel.richschema.json",
    "title": "Weasel User Settings",
    "description": "Weasel-Next 用户设置文件",
    "type": "object",
    "properties": {
      "$schema": {
        "description": "JSON Schema 文件的 URI",
        "type": "string"
      },
      "theme": {
        "description": "主题名称（对应程序文件夹里的 weasel_theme_<名字>.dll；当前只有 official）",
        "type": "string",
        "enum": [
          "official"
        ],
        "title": "主题"
      },
      "ascii_mode": {
        "description": "新输入会话默认使用英文模式",
        "type": "boolean",
        "title": "默认英文模式"
      },
      "global_ascii_status": {
        "description": "所有应用共享中英文状态",
        "type": "boolean",
        "title": "共享中英文状态"
      },
      "input_mode_indicator": {
        "description": "控制何时在输入位置附近短暂显示当前中英文模式。同一输入区域内移动光标不会重复显示。",
        "type": "string",
        "enum": [
          "focus_and_switch",
          "switch_only",
          "never"
        ],
        "title": "中英文模式提示"
      },
      "input_mode_indicator_duration_ms": {
        "description": "模式提示从实际显示起保留的时间，单位为毫秒。",
        "type": "integer",
        "minimum": 100,
        "maximum": 10000,
        "title": "模式提示时长"
      },
      "allow_rime_in_secure_fields": {
        "description": "关闭时，密码等安全输入区域将绕过 Rime 并直接交给应用。仅当密码包含必须通过输入法转换的内容（例如中文）时才建议开启。",
        "type": "boolean",
        "title": "允许 Rime 处理安全输入区域"
      },
      "app_options": {
        "description": "按宿主程序文件名配置新输入会话的默认选项",
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "ascii_mode": {
              "description": "新会话默认使用英文模式；未指定时继承全局 ascii_mode，不覆盖已有会话的手动切换",
              "type": "boolean",
              "title": "默认英文模式"
            },
            "inline_preedit": {
              "description": "是否在该宿主编辑框内联显示预编辑文本；未指定时用主题的值（theme.yaml 的 style/inline_preedit），主题不支持外部预编辑时仍回退内联",
              "type": "boolean",
              "title": "内联预编辑"
            }
          },
          "additionalProperties": false
        },
        "examples": [
          {
            "cmd.exe": {
              "ascii_mode": true
            }
          }
        ],
        "title": "应用专属设置"
      },
      "themeSettings": {
        "description": "按主题划分的自定义设置，键为主题名称，值为该主题的设置对象",
        "type": "object",
        "properties": {
          "wasm": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "description": "加载同名 .wasm 模块",
                "title": "主题"
              },
              "modules": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "title": "名称"
                    },
                    "config": {
                      "type": "object",
                      "title": "配置"
                    },
                    "file": {
                      "type": "string",
                      "description": "模块路径；依次查找程序目录 theme-wasm/<id>.wasm、用户数据目录 <id>.wasm",
                      "title": "模块文件"
                    }
                  },
                  "additionalProperties": false
                },
                "title": "WASM 模块"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": {
          "type": "object"
        }
      },
      "asset": {
        "description": "数据文件夹名（相对程序文件夹），存放 Rime-Next 的数据树。",
        "type": "string",
        "title": "数据文件夹名"
      },
      "sound": {
        "description": "键声与上屏音；路径相对数据文件夹（asset）。",
        "type": "object",
        "title": "声音",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "description": "是否播放按键/上屏音",
            "type": "boolean",
            "title": "启用声音"
          },
          "key": {
            "description": "按键音 wav（相对数据文件夹）",
            "type": "string",
            "title": "按键音"
          },
          "commit": {
            "description": "上屏音 wav（相对数据文件夹）",
            "type": "string",
            "title": "上屏音"
          }
        }
      }
    },
    "additionalProperties": false,
    "examples": [
      {
        "theme": "eleven",
        "themeSettings": {
          "abc": {}
        }
      }
    ]
  },
  "ui": {
    "fields": {
      "/theme": {
        "order": 0
      },
      "/ascii_mode": {
        "order": 10
      },
      "/global_ascii_status": {
        "order": 20
      },
      "/input_mode_indicator": {
        "order": 22,
        "choices": [
          "进入输入区域及切换中英文时显示",
          "仅切换中英文时显示",
          "不显示"
        ]
      },
      "/input_mode_indicator_duration_ms": {
        "order": 23
      },
      "/allow_rime_in_secure_fields": {
        "order": 25
      },
      "/app_options": {
        "order": 50
      },
      "/themeSettings": {
        "order": 60,
        "hidden": true
      }
    }
  }
}
