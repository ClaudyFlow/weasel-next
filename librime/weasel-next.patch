+// toml_lite —— librime 用的平铺 TOML 子集解析/生成。
+//
+// 为什么要它：installation.yaml / user.yaml 这两个引擎状态文件要改成 .toml，
+// 而 librime 的配置层是 yaml-cpp，读不了 TOML。这里实现**只覆盖我们用到的那点语法**：
+//
+//   key = "字串"        # 双引号字符串，支持 \" \\ \n \t 转义
+//   key = 123           # 整数
+//   key = 1.5           # 浮点
+//   key = true / false  # 布尔
+//   [section]           # 分段 → 嵌套 ConfigMap
+//   # 注释、空行        忽略
+//
+// 不支持（也用不到）：数组、内联表、多行字符串、日期时间。
+
+#ifndef RIME_TOML_LITE_H_
+#define RIME_TOML_LITE_H_
+
+#include <map>
+#include <string>
+
+#include <rime/common.h>
+#include <rime/config.h>
+
+namespace rime {
+
+/// 解析平铺 TOML 子集。成功返回根 ConfigMap；语法有错返回 nullptr。
+an<ConfigItem> ParseTomlLite(const std::string& text);
+
+/// 读文件并解析。文件不存在或解析失败返回 false。
+bool LoadTomlLite(const path& file, an<ConfigItem>* out);
+
+/// 把一层的 键→值 写成 TOML（值按字串加引号；写 installation 那种文件用）。
+std::string WriteTomlLite(const std::map<std::string, std::string>& flat);
+
+}  // namespace rime
+
+#endif  // RIME_TOML_LITE_H_
