+// 一一对应，这个恒等式同时约束解析侧与扫描侧。
+static string series_subdir(const string& resource_id) {
+  string subdir;
+  size_t start = 0;
+  for (size_t i = 0; i <= resource_id.size(); ++i) {
+    if (i == resource_id.size() || resource_id[i] == '.') {
+      if (i > start) {
