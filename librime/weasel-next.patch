+// [Weasel-Next] 方案清单读取（TOML）。
+//
+// 方案清单的唯一落点是 `<用户目录>/schema/schema.toml`：
+//   schemas = [ "luna_pinyin", "stroke" ]      # 多行亦可
+//
+// librime 的配置层是 yaml-cpp ✓ 读不了 TOML，所以这里带一个**平铺 TOML 子集**解析器
+// （键值 + `[段]` + 字符串数组），只服务这一个用途。
+#ifndef RIME_TOML_LITE_H_
+#define RIME_TOML_LITE_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include <rime/config.h>
+#include <rime/common.h>
+
+namespace rime {
+
+/// 解析平铺 TOML 子集。成功返回根 ConfigMap；语法有错返回 nullptr。
+an<ConfigItem> ParseTomlLite(const std::string& text);
+
+/// 读文件并解析。文件不存在或解析失败返回 false。
+bool LoadTomlLite(const path& file, an<ConfigItem>* out);
+
+/// 读 `<用户目录>/schema/schema.toml` 的 `schemas = [...]`，返回方案 id（保持原顺序）。
+///
+/// 文件不存在或语法有错时返回空列表 —— 调用方据此回退 `default.yaml` 自带的 `schema_list`。
+std::vector<std::string> LoadSchemaIdsFromToml();
+
+}  // namespace rime
+
+#endif  // RIME_TOML_LITE_H_
