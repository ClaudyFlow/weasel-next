+#include "toml_lite.h"
+
+#include <cctype>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+
+namespace rime {
+
+namespace {
+
+std::string Trim(const std::string& s) {
+  size_t b = s.find_first_not_of(" \t\r\n");
+  if (b == std::string::npos)
+    return "";
+  size_t e = s.find_last_not_of(" \t\r\n");
+  return s.substr(b, e - b + 1);
+}
+
+// 去掉行尾注释（引号内的 # 不算）。
+std::string StripComment(const std::string& line) {
+  bool in_quote = false;
+  for (size_t i = 0; i < line.size(); ++i) {
+    char c = line[i];
+    if (c == '\\' && in_quote) {
+      ++i;
+      continue;
+    }
+    if (c == '"')
+      in_quote = !in_quote;
+    else if (c == '#' && !in_quote)
+      return line.substr(0, i);
+  }
+  return line;
+}
+
+bool UnescapeInto(const std::string& raw, std::string* out) {
+  for (size_t i = 0; i < raw.size(); ++i) {
+    char c = raw[i];
+    if (c != '\\') {
+      out->push_back(c);
+      continue;
+    }
+    if (++i >= raw.size())
+      return false;
+    switch (raw[i]) {
+      case 'n': out->push_back('\n'); break;
+      case 't': out->push_back('\t'); break;
+      case 'r': out->push_back('\r'); break;
+      case '"': out->push_back('"'); break;
+      case '\\': out->push_back('\\'); break;
+      default: return false;
+    }
+  }
+  return true;
+}
+
+// 把右侧的值文本解析成 ConfigValue。
+an<ConfigItem> ParseValue(const std::string& text) {
+  std::string v = Trim(text);
+  if (v.empty())
+    return nullptr;
+  if (v.size() >= 2 && v.front() == '"' && v.back() == '"') {
+    std::string out;
+    if (!UnescapeInto(v.substr(1, v.size() - 2), &out))
+      return nullptr;
+    return New<ConfigValue>(out);
+  }
+  if (v == "true")
+    return New<ConfigValue>(true);
+  if (v == "false")
+    return New<ConfigValue>(false);
+  // 整数 / 浮点
+  char* end = nullptr;
+  double d = std::strtod(v.c_str(), &end);
+  if (end && *end == '\0' && end != v.c_str()) {
+    if (v.find('.') == std::string::npos && v.find('e') == std::string::npos &&
+        v.find('E') == std::string::npos)
+      return New<ConfigValue>(static_cast<int>(d));
+    return New<ConfigValue>(d);
+  }
+  return nullptr;  // 未加引号的裸字串：TOML 不允许，这里也拒绝
+}
+
+}  // namespace
+
+an<ConfigItem> ParseTomlLite(const std::string& text) {
+  auto root = New<ConfigMap>();
+  an<ConfigMap> current = root;
+  std::istringstream stream(text);
+  std::string line;
+  while (std::getline(stream, line)) {
+    std::string s = Trim(StripComment(line));
+    if (s.empty())
+      continue;
+    if (s.front() == '[') {
+      if (s.back() != ']')
+        return nullptr;
+      std::string section = Trim(s.substr(1, s.size() - 2));
+      if (section.empty())
+        return nullptr;
+      auto node = New<ConfigMap>();
+      current->Set(section, node);
+      current = node;
+      continue;
+    }
+    size_t eq = s.find('=');
+    if (eq == std::string::npos)
+      return nullptr;
+    std::string key = Trim(s.substr(0, eq));
+    if (key.empty())
+      return nullptr;
+    an<ConfigItem> value = ParseValue(s.substr(eq + 1));
+    if (!value)
+      return nullptr;
+    current->Set(key, value);
+  }
+  return root;
+}
+
+bool LoadTomlLite(const path& file, an<ConfigItem>* out) {
+  std::ifstream input(file.c_str(), std::ios::binary);
+  if (!input)
+    return false;
+  std::ostringstream buffer;
+  buffer << input.rdbuf();
+  an<ConfigItem> parsed = ParseTomlLite(buffer.str());
+  if (!parsed)
+    return false;
warning: in the working copy of 'src/rime/toml_lite.h', LF will be replaced by CRLF the next time Git touches it
+  if (out)
+    *out = parsed;
+  return true;
+}
+
+std::string WriteTomlLite(const std::map<std::string, std::string>& flat) {
+  std::string out;
+  for (const auto& kv : flat) {
+    out += kv.first;
+    out += " = ";
+    const std::string& v = kv.second;
+    bool plain = (v == "true" || v == "false");
+    if (!plain && !v.empty()) {
+      char* end = nullptr;
+      std::strtod(v.c_str(), &end);
+      if (end && *end == '\0')
+        plain = true;  // 数字不加引号
+    }
+    if (plain) {
+      out += v;
+    } else {
+      out += '"';
+      for (char c : v) {
+        if (c == '"' || c == '\\')
+          out.push_back('\\');
+        out.push_back(c);
+      }
+      out += '"';
+    }
+    out += "\n";
+  }
+  return out;
+}
