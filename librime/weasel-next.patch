+// [Weasel-Next 补丁] 分类布局下枚举方案源文件（2026-10-25 系列文件夹版）：
+//   递归扫 <root>/schema/，只认 <系列…>/<id>.schema.yaml，且相对 schema/ 的目录链
+//   必须逐段等于 id 按 '.' 分段：
+//     yuling      → schema/yuling/yuling.schema.yaml
+//     yuling.five → schema/yuling/five/yuling.five.schema.yaml
+//   不等即跳过 —— 少任何一级，该文件任何 ID 都解析不到（解析器按同一恒等式找）。
+//   schema/ 根下的扁平文件同样不认（2026-10-25 起无扁平回退）。
+//   排序只为结果确定（directory_iterator 顺序不保证）。
+static vector<path> classified_schema_sources(const path& root) {
+  vector<path> files;
+  const path schema_dir = root / "schema";
+  std::error_code ec;
+  if (!fs::is_directory(schema_dir, ec))
+    return files;
+  for (fs::recursive_directory_iterator it(schema_dir, ec), end; it != end;
+       it.increment(ec)) {
+    if (ec)
+      break;
+    const path entry(it->path());
+    if (!fs::is_regular_file(entry, ec))
+      continue;
+    const string name = entry.filename().to_utf8_string();
+    const string suffix = ".schema.yaml";
+    if (name.size() <= suffix.size() ||
+        name.compare(name.size() - suffix.size(), suffix.size(), suffix) != 0)
+      continue;
+    const string id = name.substr(0, name.size() - suffix.size());
+    // 期望的目录链：id 按 '.' 分段
+    vector<string> expected;
+    size_t start = 0;
+    for (size_t i = 0; i <= id.size(); ++i) {
+      if (i == id.size() || id[i] == '.') {
+        if (i > start)
+          expected.push_back(id.substr(start, i - start));
+        start = i + 1;
+      }
+    }
+    // 实际目录链：相对 schema/ 的各级目录名
+    const auto rel = fs::relative(entry.parent_path(), schema_dir, ec);
+    if (ec)
+      continue;
+    vector<string> actual;
+    for (const auto& part : rel)
+      actual.push_back(path(part).to_utf8_string());
+    if (actual != expected)
+      continue;  // 文件夹链与文件名主干不符，任何 ID 都解析不到
+    files.push_back(entry);
+  }
+  std::sort(files.begin(), files.end());
+  return files;
+}
