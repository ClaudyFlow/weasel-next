--- /dev/null
+++ b/src/rime/toml_lite.cc
@@ -0,0 +1,275 @@
+// [Weasel-Next] 平铺 TOML 子集解析 + 方案清单读取。
+//
+// 为什么需要它：方案清单与安装信息要写成 `.toml`，而 librime 的配置层是 yaml-cpp，
+// 读不了 TOML。这里实现**只覆盖我们用到的那点语法**：
+//
+//   key = "字串"           # 双引号字符串，支持 \" \\ \n \t 转义
+//   key = 123              # 整数
+//   key = 1.5              # 浮点
+//   key = true / false     # 布尔
+//   key = ["a", "b"]       # 字符串数组（可跨行，方案清单用）
+//   [section]              # 分段 → 嵌套 ConfigMap
+//   # 注释、空行           忽略
+//
+// 不支持（也用不到）：内联表、多行字符串、日期时间、数字数组。
+
+#include "toml_lite.h"
+
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+
+#include <rime/config.h>
+#include <rime/service.h>
+
+namespace rime {
+
+namespace {
+
+std::string Trim(const std::string& s) {
+  size_t b = s.find_first_not_of(" \t\r\n");
+  if (b == std::string::npos)
+    return "";
+  size_t e = s.find_last_not_of(" \t\r\n");
+  return s.substr(b, e - b + 1);
+}
+
+// 去掉行尾注释（引号内的 # 不算）。
+std::string StripComment(const std::string& line) {
+  bool in_quote = false;
+  for (size_t i = 0; i < line.size(); ++i) {
+    char c = line[i];
+    if (c == '\\' && in_quote) {
+      ++i;
+      continue;
+    }
+    if (c == '"')
+      in_quote = !in_quote;
+    else if (c == '#' && !in_quote)
+      return line.substr(0, i);
+  }
+  return line;
+}
+
+bool UnescapeInto(const std::string& raw, std::string* out) {
+  for (size_t i = 0; i < raw.size(); ++i) {
+    char c = raw[i];
+    if (c != '\\') {
+      out->push_back(c);
+      continue;
+    }
+    if (++i >= raw.size())
+      return false;
+    switch (raw[i]) {
+      case 'n': out->push_back('\n'); break;
+      case 't': out->push_back('\t'); break;
+      case 'r': out->push_back('\r'); break;
+      case '"': out->push_back('"'); break;
+      case '\\': out->push_back('\\'); break;
+      default: return false;
+    }
+  }
+  return true;
+}
+
+// 把 `["a", "b", "c"]` 解析成 ConfigList（只支持双引号字符串元素）。
+an<ConfigItem> ParseStringArray(const std::string& text) {
+  std::string v = Trim(text);
+  if (v.size() < 2 || v.front() != '[' || v.back() != ']')
+    return nullptr;
+  auto list = New<ConfigList>();
+  std::string body = v.substr(1, v.size() - 2);
+  std::string current;
+  bool in_quote = false;
+  bool escaped = false;
+  bool has_item = false;
+  auto flush = [&]() -> bool {
+    std::string item = Trim(current);
+    current.clear();
+    if (item.empty())
+      return true;
+    if (item.size() < 2 || item.front() != '"' || item.back() != '"')
+      return false;
+    std::string out;
+    if (!UnescapeInto(item.substr(1, item.size() - 2), &out))
+      return false;
+    list->Append(New<ConfigValue>(out));
+    has_item = true;
+    return true;
+  };
+  for (char c : body) {
+    if (escaped) {
+      current.push_back(c);
+      escaped = false;
+      continue;
+    }
+    if (in_quote && c == '\\') {
+      current.push_back(c);
+      escaped = true;
+      continue;
+    }
+    if (c == '"') {
+      in_quote = !in_quote;
+      current.push_back(c);
+      continue;
+    }
+    if (c == ',' && !in_quote) {
+      if (!flush())
+        return nullptr;
+      continue;
+    }
+    current.push_back(c);
+  }
+  if (in_quote || !flush())
+    return nullptr;
+  return has_item ? list : nullptr;
+}
+
+// 参数文本是否是一个尚未闭合的数组（跨行书写时用来继续读下一行）。
+bool ArrayIsOpen(const std::string& text) {
+  std::string v = Trim(text);
+  if (v.empty() || v.front() != '[')
+    return false;
+  bool in_quote = false;
+  bool escaped = false;
+  for (char c : v) {
+    if (escaped) {
+      escaped = false;
+      continue;
+    }
+    if (in_quote && c == '\\') {
+      escaped = true;
+      continue;
+    }
+    if (c == '"')
+      in_quote = !in_quote;
+  }
+  return in_quote || v.back() != ']';
+}
+
+// 把右侧的值文本解析成 ConfigValue。
+an<ConfigItem> ParseValue(const std::string& text) {
+  if (an<ConfigItem> array = ParseStringArray(text))
+    return array;
+  std::string v = Trim(text);
+  if (v.empty())
+    return nullptr;
+  if (v.size() >= 2 && v.front() == '"' && v.back() == '"') {
+    std::string out;
+    if (!UnescapeInto(v.substr(1, v.size() - 2), &out))
+      return nullptr;
+    return New<ConfigValue>(out);
+  }
+  if (v == "true")
+    return New<ConfigValue>(true);
+  if (v == "false")
+    return New<ConfigValue>(false);
+  // 整数 / 浮点（含 0x 十六进制整数）
+  if (v.size() > 2 && v[0] == '0' && (v[1] == 'x' || v[1] == 'X')) {
+    char* end = nullptr;
+    long long value = std::strtoll(v.c_str() + 2, &end, 16);
+    if (end && *end == '\0')
+      return New<ConfigValue>(static_cast<int>(value));
+  }
+  char* end = nullptr;
+  double d = std::strtod(v.c_str(), &end);
+  if (end && *end == '\0' && end != v.c_str()) {
+    if (v.find('.') == std::string::npos && v.find('e') == std::string::npos &&
+        v.find('E') == std::string::npos)
+      return New<ConfigValue>(static_cast<int>(d));
+    return New<ConfigValue>(d);
+  }
+  return nullptr;  // 未加引号的裸字串：TOML 不允许，这里也拒绝
+}
+
+}  // namespace
+
+an<ConfigItem> ParseTomlLite(const std::string& text) {
+  auto root = New<ConfigMap>();
+  an<ConfigMap> current = root;
+  std::istringstream stream(text);
+  std::string line;
+  while (std::getline(stream, line)) {
+    std::string s = Trim(StripComment(line));
+    if (s.empty())
+      continue;
+    if (s.front() == '[') {
+      if (s.back() != ']')
+        return nullptr;
+      std::string section = Trim(s.substr(1, s.size() - 2));
+      if (section.empty())
+        return nullptr;
+      auto node = New<ConfigMap>();
+      current->Set(section, node);
+      current = node;
+      continue;
+    }
+    size_t eq = s.find('=');
+    if (eq == std::string::npos)
+      return nullptr;
+    std::string key = Trim(s.substr(0, eq));
+    if (key.size() >= 2 && key.front() == '"' && key.back() == '"')
+      key = key.substr(1, key.size() - 2);
+    if (key.empty())
+      return nullptr;
+    std::string raw = s.substr(eq + 1);
+    // 数组可以跨行：一直读到闭合为止
+    if (ArrayIsOpen(raw)) {
+      std::string joined = raw;
+      bool closed = false;
+      while (std::getline(stream, line)) {
+        joined += " " + Trim(StripComment(line));
+        if (!ArrayIsOpen(joined)) {
+          closed = true;
+          break;
+        }
+      }
+      if (!closed)
+        return nullptr;
+      raw = joined;
+    }
+    an<ConfigItem> value = ParseValue(raw);
+    if (!value)
+      return nullptr;
+    current->Set(key, value);
+  }
+  return root;
+}
+
+bool LoadTomlLite(const path& file, an<ConfigItem>* out) {
+  std::ifstream input(file.c_str(), std::ios::binary);
+  if (!input)
+    return false;
+  std::ostringstream buffer;
+  buffer << input.rdbuf();
+  an<ConfigItem> parsed = ParseTomlLite(buffer.str());
+  if (!parsed)
+    return false;
+  if (out)
+    *out = parsed;
+  return true;
+}
+
+std::vector<std::string> LoadSchemaIdsFromToml() {
+  std::vector<std::string> ids;
+  path file =
+      Service::instance().deployer().user_data_dir / "schema" / "schema.toml";
+  an<ConfigItem> node;
+  if (!LoadTomlLite(file, &node) || !node)
+    return ids;
+  auto map = As<ConfigMap>(node);
+  // ⚠️ 必须用 Get + As<ConfigList>，**不能**用 GetValue：
+  //    ConfigMap::GetValue 实现是 `As<ConfigValue>(Get(key))`，而 schemas 是**数组**，
+  //    As<ConfigValue> 对 kList 一律返回 null ⇒ 明明 HasKey(schemas)=1、键总数=1，
+  //    这里却恒为 null ⇒ 整条 TOML 兼容链永远回退 default.yaml（2026-10-17 实测定位）。
+  auto list = map ? As<ConfigList>(map->Get("schemas")) : nullptr;
+  if (!list)
+    return ids;
+  for (auto it = list->begin(); it != list->end(); ++it) {
+    if (auto value = As<ConfigValue>(*it))
+      ids.push_back(value->str());
+  }
+  return ids;
+}
+
+}  // namespace rime
