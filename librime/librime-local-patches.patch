diff --git a/cmake/AddRCInfo.cmake b/cmake/AddRCInfo.cmake
index 5c6db8b..17bd2ff 100644
--- a/cmake/AddRCInfo.cmake
+++ b/cmake/AddRCInfo.cmake
@@ -48,7 +48,8 @@ else(build_release)
     set(arch_suffix "Win32")
   endif()
 
-  if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang") # clang
+  # rime-speed-stats: clang+mingw 走 windres，只有 MSVC 风格的 clang 才用 llvm-rc
+if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang") # clang
     set(arch_suffix "${arch_suffix} clang")
   elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU") # mingw
     set(arch_suffix "${arch_suffix} mingw")
@@ -62,7 +63,8 @@ if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
   set(CMAKE_RC_FLAGS "${CMAKE_RC_FLAGS} -c 65001")
 endif()
 # if clang build, use llvm-rc to compile resource file
-if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+# rime-speed-stats: clang+mingw 走 windres，只有 MSVC 风格的 clang 才用 llvm-rc
+if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
   set(CMAKE_RC_COMPILER "llvm-rc")
   set(CMAKE_RC_FLAGS "${CMAKE_RC_FLAGS} -finput-charset=UTF-8")
 endif()
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 9493f3f..e5f1e59 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -1,4 +1,4 @@
-aux_source_directory(. rime_api_src)
+﻿aux_source_directory(. rime_api_src)
 aux_source_directory(rime rime_base_src)
 aux_source_directory(rime/algo rime_algo_src)
 aux_source_directory(rime/config rime_config_src)
@@ -174,3 +174,19 @@ if(DEFINED RIME_SETUP_EXTRA_MODULES)
   target_compile_definitions(${rime_library} PRIVATE
     "RIME_EXTRA_MODULES=${RIME_SETUP_EXTRA_MODULES}")
 endif()
+
+# >>> rime-speed-stats input_stat plugin (build-librime-mingw.ps1) >>>
+if(RIME_INPUT_STAT_CORE_LIB)
+  add_subdirectory("C:/code/rime-speed-stats/plugin" "${CMAKE_BINARY_DIR}/rime-input-stats")
+  target_link_libraries(rime rime-input-stats)  # plain 签名：librime 自己第 84 行用的是 plain
+  # RIME_MODULE_INITIALIZER 在 GCC/Clang 下是 __attribute__((constructor))：只要插件对象
+  # 被链进来，注册就会在 DLL 加载时自动发生。但静态库对象默认不会被拉入（librime 传下来的
+  # RIME_EXTRA_MODULES 在 MinGW 下是空串，没有任何未定义符号引用它），因此这里生成一个
+  # 强制引用，保证 rime_require_module_input_stat 所在的 .o 进入 rime.dll。
+  set(_force "${CMAKE_BINARY_DIR}/rime-input-stats/force_link.cc")
+  file(WRITE "${_force}"
+    "void rime_require_module_input_stat();\n"
+    "namespace { struct ForceInputStatsLink { ForceInputStatsLink() { rime_require_module_input_stat(); } } force_input_stat_link; }\n")
+  target_sources(rime PRIVATE "${_force}")
+endif()
+# <<< rime-speed-stats input_stat plugin <<<
